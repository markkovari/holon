# The self-hosted model on csatapaci, and the queue daemon that uses it.
# The self-hosted model on csatapaci (mlx_lm.server, OpenAI-compatible, 0.0.0.0:8080).
# Sourced by the shim and by `holon goal run`; no secrets here — mlx ignores auth.
#
#   set -a; source .comp/csatapaci.env; set +a
#   SHIM_HOST=127.0.0.1 just openai-shim &        # /v1/messages -> csatapaci
#   COMP_FLEET_ALLOW_PRIVATE_EGRESS=1 holon goal run \
#     --anthropic-base-url "$HOLON_BASE_URL" \
#     --model "$OPENAI_MODEL" --answer-model "$OPENAI_MODEL" ...

OPENAI_BASE=http://csatapaci:8080/v1
OPENAI_MODEL=mlx-community/Qwen3.8-27B-4bit

# Qwen3.8-27B replaced Qwen3-Coder-30B-A3B on 2026-08-28, and the honest reason is
# that the 30B was never on this machine. `~/mlx-models` held Qwen2.5-Coder 14B and
# 32B and the mlx logs stopped on June 6; the numbers this file used to quote for a
# 30B-A3B describe a configuration that did not exist here. That is also why the
# server was down: it cannot load a model that is not on disk.
#
# So the comparison below is against what is MEASURED here, not against a claim.
#
# WHAT IT IS. 27B DENSE, not a MoE — a hybrid stack, 16 x (3 x GatedDeltaNet -> 1 x
# GatedAttention), 262144 context native. Dense is the wrong shape for this box and
# the measurement says so: every parameter is read per token, where a 3B-active MoE
# reads a fraction. Measured on this M2 Pro (96 GB, ~200 GB/s):
#
#   decode 10.4-11.3 tok/s      (1200 tokens in 106-115 s)
#
# It is on the box anyway because it is a much better model at the thing this loop
# does — SWE-bench Pro 61.7 against Opus 4.6 Max's 53.4 — and because a goal here is
# judged by a gate rather than by tokens per second.
#
# THINKING IS THE COST, NOT THE RATE. Qwen3.8 thinks by default at `xhigh`. The same
# small task measured:
#
#   thinking on    1200+ tokens, hit the cap, 106 s, unfinished
#   thinking off      158 tokens, finished,     13 s
#
# Same ~12 tok/s either way. Eight times the tokens for one answer, which at this
# decode rate is the difference between a goal that fits in GOAL_TIMEOUT and one
# that does not. Hence:
OPENAI_EXTRA_JSON={"chat_template_kwargs":{"enable_thinking":false},"top_p":0.8,"presence_penalty":1.5}
#
# Those are the model card's own non-thinking sampling parameters. The card warns
# that lower reasoning effort can raise TOTAL latency in agentic tasks through
# retries — worth re-measuring with thinking on once the goals here pass at all,
# because a gated loop makes a wrong answer cheap and a slow one expensive.
#
# `OPENAI_EXTRA_JSON` is merged into every request by tools/openai-shim.mjs, last,
# so it wins. `chat_template_kwargs` is not an Anthropic field and never will be.
#
# OPENAI_DUMP_DIR=<dir> writes every request out as JSON. Off by default. It is
# what settled the one failure this model had that looked like incompetence and
# was not — see docs/measure/local-model-ticketing.md. Two reconstructions of the
# prompt failed to reproduce it; reading the real one took a minute.

# Where the shim listens, and therefore what --anthropic-base-url is.
PORT=8787
HOLON_BASE_URL=http://127.0.0.1:8787

# A 32B on mlx is slower than the API; the branch budget has to allow for it.
# Measured: mlx BATCHES concurrent requests (4 sequences in flight during a
# two-goal, two-branch run), so MAX_RUNS and BRANCHES above 1 buy real parallelism.
#
# The server is started with --prompt-cache-size 4, NOT the 16 it had. That knob
# counts SEQUENCES, not bytes: at 14k-token prompts it grew to 22 GB across 12
# sequences and the box stopped answering — a trivial "Say OK." timed out at 110s
# with nothing else running. After the restart the same call took 4.1s. A cache
# sized in sequences is unbounded in memory, and the bound has to come from here.
# The budget has to cover DECODE, and decode is the slow half.
#
# Benchmarked single-stream (mlx_lm.benchmark): decode 72 tok/s at 1k context,
# 47 at 8k, 34 at 16k; prefill ~350 tok/s throughout. Batching is nearly free —
# 4 streams hold 38.5 tok/s EACH, so four branches cost about what one does.
#
# The ~8.7 tok/s once measured through mlx_lm.server was a serving-layer loss of
# roughly 4x (concurrency slots plus a prompt cache grown to 22 GB), not the
# model. Size budgets from the benchmark and fix the server, rather than the
# other way round.
OPENAI_TIMEOUT_MS=3300000

# --- the queue daemon (comp-goald) ---
# A person still starts each goal; the daemon drives what is in `running`.
PROJECT=holon
MAX_RUNS=1
# BELOW the server's --prompt-concurrency/--decode-concurrency of 3. Three
# branches arriving together filled every slot and mlx stalled: prefill of all
# three completed, then nothing was logged for 20 minutes at 18% CPU. Two leaves
# a slot free and the same work completes.
BRANCHES=2
ROUNDS=1
# Per-branch HTTP budget. 1800, and 900 was not generous — it was marginal.
#
# Measured against this exact server (Qwen3.8-27B-4bit on csatapaci), twice, from two
# machines, same shape both times:
#
#   prompt 58 tok,   out   20 tok      2.1s /   4.1s
#   prompt 5261 tok, out  138 tok     63.8s /  69.1s
#   prompt 5266 tok, out 2048 tok    417.2s / 303.4s
#
# The last row is what a branch actually does: a contract and a base tree in, a module
# out. A branch makes `--attempts` of those IN SEQUENCE — two by default — so a pair
# from the slow end is 834s before the gate, the composition and the build. Against 900
# that is not a budget, it is a coin flip, and `goalrun.rs` already describes what
# losing it looks like: not a timeout message but `hyper::Error(IncompleteMessage)` at
# the host and `error sending request for url .../run` at the top, which reads as a
# fleet fault and is not one.
#
# 5261 prompt tokens is also modest. A real contract plus a base tree is larger, and
# prefill is where this model is slowest — 63.8s for 138 output tokens is almost all
# prompt.
GOAL_TIMEOUT=1800
# The shared knowledge pool — what makes one goal aware of what earlier goals
# learned, and what lets a repeat goal be skipped before it spends a branch.
#
# On malna, not here. Two reasons. The pool is the ACCUMULATED half of ADR-0091's
# one store, and it is the only thing in this system that cannot be recomputed —
# so it belongs on the box that is not also the one being rebuilt and restarted
# while a model is loaded. And csatapaci holds a 15 GB model resident; a database
# competing with it for page cache is a database that makes inference slower.
#
# Bound to malna's TAILNET address only, so this reaches it and the LAN does not.
# The password is a FILE, never a value in this file (ADR-0051).
SURREAL_URL=http://malna:8000
SURREAL_NS=comp
SURREAL_DB=goalmemory
SURREAL_USER=root
# comp-goalrun takes a PATH here, and reads it itself, so the value never lands
# in argv where every user on the box can see it.
SURREAL_PASSWORD_FILE=~/.comp-secrets/surreal
#
# The lattice's NATS is malna's too — the one that is already there. The test
# harness still spawns its own on a random loopback port for every run, and must:
# forty suites depend on that isolation. This is for a long-running lattice.
# Subjects are `comp.<v>.<lattice>.…`, so two lattices on one NATS never see each
# other's traffic — which is what makes sharing a server with another project safe.
NATS_URL=nats://malna:4222

# Refuse a prompt over this rather than spending the prefill to discover it does
# not fit. Kept even though the window is now 262144: a guard whose ceiling is
# never reached costs nothing, and the day someone points this at a smaller model
# is the day it earns itself back.
OPENAI_MAX_PROMPT_TOKENS=220000
