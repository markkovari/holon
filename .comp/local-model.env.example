# Example local model environment template.
# Copy to .comp/local.env and customize:
#
#   set -a; source .comp/local.env; set +a
#   HOST=127.0.0.1 node tools/openai-shim.mjs &
#   COMP_FLEET_ALLOW_PRIVATE_EGRESS=1 holon goal run \
#     --anthropic-base-url "$HOLON_BASE_URL" \
#     --model "$OPENAI_MODEL" --answer-model "$OPENAI_MODEL"

OPENAI_BASE=http://127.0.0.1:8080/v1
OPENAI_MODEL=mlx-community/Qwen3.8-27B-4bit
