# One image, any of the twelve ADR-0095 daemons — `comp-fswatch`, `comp-docker`,
# `comp-ffmpeg`, ... — picked by build arg rather than one Dockerfile each, since
# the build is the same for each: `cargo build -p <name>` at the root (`-p`: without it every
# member's features are merged in, and one wants OpenSSL), which
# compiles that daemon's own package and the shared kit, and nothing else's
# dependencies (docs/adr/0115).
#
# Build (context = the repo root):
#   docker build -f reconciler/Dockerfile.daemon --build-arg DAEMON=comp-fswatch \
#     -t comp-fswatch .
# Run:
#   docker run -p 8000:8000 comp-fswatch --addr 0.0.0.0:8000 --allow-path /watch
#
# This is the missing half of the wasmCloud/Kubernetes lane's daemon story
# (docs/SELFHOST.md: "no equivalent yet ... still a manual step") — `holon wadm
# render --api v2` emits a Deployment from this image alongside the app's own
# Workload for every `[[daemon]]` the spec declares.
FROM rust:1-slim-bookworm AS build
ARG DAEMON
WORKDIR /src
# The root workspace: Cargo loads every member's manifest, though it builds only this daemon's graph.
COPY Cargo.toml Cargo.lock ./
COPY agent-matrix ./agent-matrix
COPY agent-runtime ./agent-runtime
COPY cli ./cli
COPY host ./host
COPY xtask ./xtask
COPY reconciler ./reconciler
COPY lattice ./lattice
COPY comp-metadata ./comp-metadata
# comp-vcs's and comp-park's engines (ADR-0099, ADR-0100) — path dependencies of their packages.
COPY crates ./crates
# comp-agentd's build script compiles api/holon/v1/agent.proto (ADR-0102); no other daemon's build
# reads it.
COPY api ./api
RUN cargo build --release -p "${DAEMON}" --bin "${DAEMON}"

FROM debian:bookworm-slim
ARG DAEMON
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Copied to a fixed path — the ARG isn't available at CMD time, and a shell CMD
# that reads it from the environment would need it re-passed on every `docker run`.
COPY --from=build /src/target/release/${DAEMON} /usr/local/bin/daemon
ENTRYPOINT ["/usr/local/bin/daemon"]
