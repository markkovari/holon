# Rust / cargo-component build output. `components/*/target/` rather than a
# list of the crates that happen to have one — the enumerated form silently
# admitted 77 MB of budget-domain's target in 1d72c91.
/components/target/
/components/*/target/
# rendered units/routes/manifests — output, not source. One rule per lane rather
# than a bare `/target/`, so a stray source file under it is still noticed.
/target/selfhost/
/target/fleet/
/target/wadm/
/target/capgraph.json
**/*.wasm

# Generated bindings. Only Rust's are ignored, and the asymmetry is deliberate:
# `cargo-component` regenerates these on every build, so a stale copy cannot
# exist. The Go and Python bindings under `components/*-go` and `components/*-py`
# ARE committed, because neither build lane runs its generator — `go build` and
# `componentize-py componentize` read them off disk. Regenerating the Go ones
# with the same wit-bindgen differs by six lines of header comment and would
# also rewrite a pinned `go.mod`. Same call as the C `.c`/`.h`, which
# tools/build-polyglot.sh already explains.
**/src/bindings.rs

# Installed npm packages for the example UIs. The lockfiles ARE committed —
# the recipes run `npm ci`, which needs one and installs nothing else. Nobody
# had a node_modules on disk here until someone ran `npm install`, which is why
# this rule arrived late.
**/node_modules/

# Playwright output. Scoped to where the UIs actually live: `**/test-results/`
# also hides `components/test-results/`, so a component by that name would be
# invisible to git rather than merely absent.
examples/*/test-results/
**/playwright-report/

# Local env
.env

# NOTE: wit/ (including wit/deps/ and wkg.lock) IS version-controlled on
# purpose — the contract and its pinned, vendored WASI dependencies are part of
# the repo so the build is reproducible offline.
sweep.json

# A local scratch database written by an MCP tool in some sessions. Not the
# project's, 1.5 MB, and it landed in a commit once by way of `git add -A`.
ruvector.db

# .NET build output for the C# polyglot reproduction (docs/POLYGLOT.md). The
# source and the csproj are committed; 164 MB of runtime packs are not.
components/*-cs/bin/
components/*-cs/obj/
# componentize-py bytecode cache, and the object wit-bindgen emits for the C
# build — regenerated by tools/build-polyglot.sh, not source.
**/__pycache__/
components/*-c/*_component_type.o
