#!/usr/bin/env bash
# Compose a component with the capabilities it imports, WITHOUT a hand-written
# plug chain.
#
# The phenomenon this exists for: every showcase in this repository is assembled
# by a bespoke `wac plug … --plug … --plug …` line in the Justfile — 59 of them at
# the time of writing — and one declarative `compose.wac` whose `--dep` list is
# still typed by hand. So the recipe for assembling an app lives beside the app in
# a build file rather than IN the app, and a component the agentic loop builds
# cannot be composed, run or deployed until a person edits that build file. A
# substrate whose whole thesis is composition should not need a human to spell the
# composition out.
#
# It does not need one. A component states its imports, every capability here
# states the package it exports, and that is a complete wiring diagram:
#
#     wasm-tools component wit clinic_domain.wasm
#       import records:store/store@0.1.0     ─┐  scan components/*/wit for
#       import id:generate/generator@0.1.0   ─┘  `package records:store@…`
#
# Recursive, because a capability may import capabilities of its own (auth-guard
# wants a rate limiter and an audit log). `wasi:*` and `comp:*` are left alone
# because the HOST satisfies those — a component that imports `comp:store/cas` is
# asking the runtime for it, not asking to be plugged.
#
# The output is CONTENT-ADDRESSED: the same inputs compose to the same path, so a
# gate that runs twenty times builds it once, and the artifact outlives the run
# that made it — which is the other half of "reusable later". Deploy it, push it
# to the catalogue, hand it to a colleague; it is a self-contained component.
#
#   bin/compose clinic-domain                 → prints the composed wasm's path
#   bin/compose clinic-domain --print-plan    → prints what it WOULD plug, and why
#
# `PLUGS_DIR` is searched FIRST, so a gate can rebuild only the crate under test and
# let every plug resolve to the artifacts `just build` already produced.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# Where built components are looked for, first hit wins. A gate that has just
# rebuilt one crate points `PLUGS_DIR` at its own output and the rest resolve here.
SEARCH="${PLUGS_DIR:+$PLUGS_DIR }$ROOT/components/target/wasm32-wasip2/release $ROOT/components/target/wasm32-wasip2/debug $ROOT/components/target/wasm32-wasip1/debug"
OUTDIR="${COMPOSE_OUT:-$ROOT/components/target/composed}"
NAME="${1:?usage: compose <component> [--print-plan]}"
PLAN_ONLY="${2:-}"

wasm_of() { # component name -> built artifact, or nothing
  # Always succeeds: `set -e` would otherwise kill the script mid-assignment on a
  # component that simply is not built yet, and the caller has a better message.
  local d f
  for d in $SEARCH; do
    f="$d/${1//-/_}.wasm"
    [ -f "$f" ] && { echo "$f"; return 0; }
  done
  return 0
}

# Which component exports which INTERFACE, read off the BUILT components rather than
# off `components/*/wit/`. Two reasons, both found the hard way: `auth-guard` has no
# wit directory at all (it targets a world in the shared root `wit/`), and a source
# directory can declare a package it does not actually export. What a component
# exports is what it can satisfy, and only the artifact knows that.
#
# Interface granularity, not package: `cache-backing` exports `cache:store/sink`
# and `cache:store/source` but NOT `cache:store/cache`, and a package-level index
# says "satisfied" for an import that then dangles straight through composition.
#
# 147 components, under a second, so there is no cache to go stale.
index_packages() {
  local d f name
  for d in $SEARCH; do
    [ -d "$d" ] || continue
    for f in "$d"/*.wasm; do
      [ -f "$f" ] || continue
      name="$(basename "$f" .wasm)"
      wasm-tools component wit "$f" 2>/dev/null \
        | sed -n 's/^[[:space:]]*export \([a-z0-9:_/@.-]*\);.*/\1/p' \
        | grep -vE '^(wasi|comp):' | sort -u | sed "s|\$| ${name//_/-}|"
    done
  done
}

imports_of() { # wasm -> the interfaces it needs someone else to provide
  wasm-tools component wit "$1" 2>/dev/null \
    | sed -n 's/^[[:space:]]*import \([a-z0-9:_/@.-]*\);.*/\1/p' \
    | grep -vE '^(wasi|comp):' | sort -u
}

PKG_INDEX="$(index_packages)"
resolve() { # interface -> component name
  echo "$PKG_INDEX" | awk -v p="$1" '$1 == p { print $2; exit }'
}

ROOT_WASM="$(wasm_of "$NAME")"
[ -n "$ROOT_WASM" ] || {
  echo "no built component for '$NAME' under any of: $SEARCH" >&2
  echo "  build it first: cargo component build --target wasm32-wasip2 -p $NAME" >&2
  exit 1
}

# Compose the DIRECT imports first, each one whole, then plug those.
#
# A flat `wac plug root --plug a --plug b` does not do this: it satisfies the
# ROOT's imports and hoists every plug's own imports up into the result. Measured
# here — the flat chain left `audit:log`, `ratelimit:guard` and `llm:inference`
# dangling on a "composed" vet clinic that `wasm-tools validate` was perfectly
# happy with. That is the exact reason the Justfile carries `guard_composed` as a
# separate step. Recursion generalises that hand-built step to every capability.
DEPTH="${COMPOSE_DEPTH:-0}"
[ "$DEPTH" -lt 8 ] || { echo "capability cycle at '$NAME' (depth $DEPTH)" >&2; exit 1; }
INDENT="$(printf '%*s' $((DEPTH * 2)) '')"

DEPS=""
UNMET=""
for iface in $(imports_of "$ROOT_WASM"); do
  dep="$(resolve "$iface")"
  if [ -z "$dep" ]; then
    UNMET="$UNMET$iface
"
    continue
  fi
  [ "$dep" = "$NAME" ] && continue   # a component may re-export what it imports
  DEPS="$DEPS$dep $iface
"
done
DEP_NAMES="$(echo "$DEPS" | awk 'NF {print $1}' | awk '!seen[$0]++')"

# An unsatisfiable import is worth a word ONLY if nothing on either side of the
# plug comes from that package. `audit:log/types` dangles on a perfectly composed
# component because it is a types-only interface with nothing to implement — the
# component importing it exports that package itself. A truly missing capability
# has no plug and no self-export behind it, and that is the one worth saying.
for iface in $UNMET; do
  pkg="${iface%%/*}"
  echo "$DEPS" | awk -v p="$pkg/" 'NF && index($2, p) == 1 { found = 1 } END { exit !found }' && continue
  echo "$PKG_INDEX" | awk -v p="$pkg/" -v me="$NAME" 'index($1, p) == 1 && $2 == me { found = 1 } END { exit !found }' && continue
  echo "$INDENT  ! nothing built exports $iface (imported by $NAME)" >&2
done

if [ "$PLAN_ONLY" = "--print-plan" ]; then
  echo "$INDENT$NAME imports:"
  echo "$DEPS" | awk -v i="$INDENT" 'NF {printf "%s  %-18s satisfies %s\n", i, $1, $2}'
  for dep in $DEP_NAMES; do
    COMPOSE_DEPTH=$((DEPTH + 1)) "$0" "$dep" --print-plan | grep -v 'imports:$' || true
  done
  exit 0
fi

# Each dep composed to its own content-addressed artifact — which is also the
# reuse: `cache-backing` is composed once and every app that wants a cache plugs
# the same file.
PLUGS=""
for dep in $DEP_NAMES; do
  PLUGS="$PLUGS $(COMPOSE_DEPTH=$((DEPTH + 1)) "$0" "$dep")"
done

# Content-addressed: hash the inputs, so the name is known before the work and a
# second caller skips it entirely.
mkdir -p "$OUTDIR"
# shellcheck disable=SC2086
STAMP="$(cat "$ROOT_WASM" $PLUGS | shasum -a 256 | cut -c1-16)"
OUT="$OUTDIR/${NAME}.${STAMP}.wasm"
if [ -f "$OUT" ]; then
  echo "$OUT"
  exit 0
fi

if [ -z "$PLUGS" ]; then
  cp "$ROOT_WASM" "$OUT"
else
  PLUG_ARGS=""
  for p in $PLUGS; do PLUG_ARGS="$PLUG_ARGS --plug $p"; done
  # shellcheck disable=SC2086
  wac plug "$ROOT_WASM" $PLUG_ARGS -o "$OUT.tmp" || {
    echo "$INDENT  ! could not plug $NAME with:$PLUGS" >&2; exit 1; }
  mv "$OUT.tmp" "$OUT"
fi
wasm-tools validate "$OUT"
echo "$OUT"
