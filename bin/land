#!/usr/bin/env bash
# Land a merged goal's components onto main, WHOLE. Run AFTER `gh pr merge`
# (which puts the implemented sources on main). It fills in the scaffold files
# the PR did not carry — Cargo.toml, wit, the non-writable lib.rs — WITHOUT
# clobbering the merged implementation (cp -Rn, no-clobber), and rebuilds the
# members list from what is on disk. Fixes both recurring slips: a missing file
# (whole dir) and a hand-edited members list. Portable (no bash-4 mapfile).
#
# Usage: bin/land <run-checkout> <component>...
set -euo pipefail
CHECKOUT="${1:?usage: land <run-checkout> <component>...}"; shift
ROOT="$(cd "$(dirname "$0")/.." && pwd)"; cd "$ROOT"
for c in "$@"; do
  mkdir -p "components/$c"
  cp -Rn "$CHECKOUT/components/$c/." "components/$c/"   # fill missing files, keep merged impl
done
python3 - "$ROOT" <<'PY'
import os, re, sys
comp = os.path.join(sys.argv[1], "components")
def member(d):
    cp = os.path.join(comp, d, "Cargo.toml")
    return os.path.isfile(cp) and "[workspace]" not in open(cp).read()
ms = sorted(d for d in os.listdir(comp) if d != "target" and member(d))
f = os.path.join(comp, "Cargo.toml"); s = open(f).read()
open(f, "w").write(re.sub(r"members\s*=\s*\[[^\]]*\]",
                          "members = [" + ", ".join(f'"{m}"' for m in ms) + "]", s, 1))
PY
echo "landed (scaffold filled, impl kept): $*"
