// binder:app — a Pokémon card binder: scan, price, and what the collection is worth.
//
// The app is the composition. Every number it reports comes from a capability it
// imports and none of the arithmetic lives here: `card:identify` reads a vision
// model's answer into fields, `price:history` decides what a card was worth at an
// instant, and `portfolio:value` turns the buy/sell log into cost basis, realised
// and unrealised gain. This component owns the HTTP surface and the storage, which
// is the part that is genuinely about being an app.
//
// That split is the repository's rule rather than a preference (ADR-0095): the
// pieces meet through WIT, so each of them is testable — and tested — on its own,
// and none of them can be reached except through its contract.
package binder:app@0.1.0;

world binder-domain {
    export wasi:http/incoming-handler@0.2.0;

    /// Accounts, sessions and token introspection. A collection belongs to
    /// somebody, and "somebody" has to be a subject the app did not invent —
    /// which is also what makes selling a card to another person possible later.
    import auth:identity/accounts@0.1.0;
    import auth:identity/authorizer@0.1.0;
    import auth:identity/types@0.1.0;

    /// Is this deck legal, and what is missing from the collection to build it.
    import deck:build/builder@0.1.0;

    /// Show a model the photograph. WHICH model is a deployment choice — this app
    /// names no vendor, and swapping in a local one changes nothing here.
    import vision:describe/describer@0.1.0;
    /// A photographed card into typed fields, plus what a person should check.
    import card:identify/identifier@0.1.0;
    /// What a card was worth at an instant, across gaps in the quotes.
    import price:history/history@0.1.0;
    /// Cost basis, realised and unrealised gain, and the value series.
    import portfolio:value/valuation@0.1.0;

    /// A `.csv` or `.xlsx` someone exported, as header and rows. Bulk entry is how
    /// a collection that already exists somewhere else gets in here, and it is the
    /// difference between trying this app and using it.
    ///
    /// The app does not parse either format: `sheet:ingest` composes `csv:codec`
    /// and `zip:archive` to do that, and what arrives here is already rows.
    import sheet:ingest/reader@0.1.0;

    /// A swap, handed over as a square somebody photographs. `portfolio:value`
    /// already says what a swap MEANS — "a swap is two events, not one" — and this
    /// is the app finally doing it.
    ///
    /// Neither of these knows anything about cards; both existed before this app.
    import qr:encode/encoder@0.1.0;
    import id:generate/generator@0.1.0;

    /// The collection itself. A bucket per app, named by the app (ADR-0023), so
    /// isolation is the linker's rather than a naming convention's.
    import wasi:keyvalue/store@0.2.0-draft;
    /// `at` is a parameter everywhere in the capabilities above, so the app is the
    /// only thing that needs to know what "now" is.
    import wasi:clocks/wall-clock@0.2.0;
    import wasi:random/random@0.2.0;
}
