    _ => return Err(InvalidJson("merge-patch"))
  }
  let root_box : RootRef = { root: root }
  merge(root_box, patch)
  Ok(root_box.root.stringify())
}

///|
pub fn diff(source : String, target : String) -> Result[String, PatchError] {
  let from_val = @json.parse(source) catch {
    _ => return Err(InvalidJson("from"))
  }
  let to_val = @json.parse(target) catch {
    _ => return Err(InvalidJson("to"))
  }
  Ok(diff_value(from_val, to_val).stringify())
}
