///|
pub fn apply_patch(document : String, patch : String) -> Result[String, PatchError] {
  let root = @json.parse(document) catch {
    _ => return Err(InvalidJson("document"))
  }
  let patch_val = @json.parse(patch) catch {
    _ => return Err(InvalidJson("patch"))
  }
  let ops = match patch_val {
    Array(arr) => arr
    _ => return Err(InvalidPatch("patch must be a JSON array of ops"))
  }
  let root_box : RootRef = { root: root }
  for op in ops {
    match apply_op(root_box, op) {
      Ok(_) => ()
      Err(e) => return Err(e)
    }
  }
  Ok(root_box.root.stringify())
}

///|
