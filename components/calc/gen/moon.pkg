import {
  "demo/calc/gen/interface/demo/calc/arith" @arith,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportEval:demo:calc/arith@0.1.0#eval"
      ],
    },
  },
)
