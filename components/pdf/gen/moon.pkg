import {
  "pdf/codec/gen/interface/pdf/codec/codec" @codec,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportRender:pdf:codec/codec@0.1.0#render",
        "wasmExportRenderPostReturn:cabi_post_pdf:codec/codec@0.1.0#render"
      ],
    },
  },
)
