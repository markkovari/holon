// Generated by `wit-bindgen` 0.63.0. DO NOT EDIT!

let page_w : Int = 612
let page_h : Int = 792
let margin : Int = 54
let top : Int = page_h - margin
let default_size : UInt = 11U

priv struct Line {
  x : Int
  y : Int
  size : UInt
  bold : Bool
  text : Array[Byte]
}

fn winansi(c : Char) -> Byte? {
  let code = c.to_int()
  if code == '—'.to_int() { Some((0x97).to_byte()) }
  else if code == '–'.to_int() { Some((0x96).to_byte()) }
  else if code == '‘'.to_int() { Some((0x91).to_byte()) }
  else if code == '’'.to_int() { Some((0x92).to_byte()) }
  else if code == '“'.to_int() { Some((0x93).to_byte()) }
  else if code == '”'.to_int() { Some((0x94).to_byte()) }
  else if code == '•'.to_int() { Some((0x95).to_byte()) }
  else if code == '…'.to_int() { Some((0x85).to_byte()) }
  else if code == '€'.to_int() { Some((0x80).to_byte()) }
  else if code == '™'.to_int() { Some((0x99).to_byte()) }
  else if code <= 0xFF { Some(code.to_byte()) }
  else { None }
}

fn escape_text(s : String) -> Array[Byte] {
  let out : Array[Byte] = []
  for c in s {
    let code = c.to_int()
    if code == '('.to_int() || code == ')'.to_int() || code == '\\'.to_int() {
      out.push((92).to_byte()) // '\\'
      out.push(code.to_byte())
    } else {
      match winansi(c) {
        Some(b) => out.push(b)
        None => out.push((63).to_byte()) // '?'
      }
    }
  }
  out
}

fn layout(doc : Document) -> Array[Array[Line]] {
  let pages : Array[Array[Line]] = [[]]
  let mut y = top

  let blocks : Array[Block] = []
  if !doc.title.is_empty() {
    blocks.push({ text: doc.title, size: 20U, bold: true, gap_before: 0U })
    blocks.push({ text: "", size: 6U, bold: false, gap_before: 0U })
  }
  for b in doc.blocks {
    blocks.push(b)
  }

  for b in blocks {
    let size = if b.size == 0U { default_size } else { b.size }
    let leading = (size.reinterpret_as_int() * 7) / 5 + 2
    y = y - b.gap_before.reinterpret_as_int()
    if y - leading < margin {
      pages.push([])
      y = top
    }
    y = y - leading
    pages[pages.length() - 1].push({
      x: margin,
      y,
      size,
      bold: b.bold,
      text: escape_text(b.text),
    })
  }
  pages
}

fn push_str(buf : Array[Byte], s : String) -> Unit {
  for ch in s {
    buf.push(ch.to_int().to_byte())
  }
}

fn push_bytes(buf : Array[Byte], src : Array[Byte]) -> Unit {
  for b in src {
    buf.push(b)
  }
}

fn content(lines : Array[Line]) -> Array[Byte] {
  let s : Array[Byte] = []
  for ln in lines {
    if ln.text.is_empty() {
      continue
    }
    let font = if ln.bold { "F2" } else { "F1" }
    push_str(s, "BT /\{font} \{ln.size} Tf \{ln.x} \{ln.y} Td (")
    push_bytes(s, ln.text)
    push_str(s, ") Tj ET\n")
  }
  s
}

fn pad10(n : Int) -> String {
  let mut s = n.to_string()
  while s.length() < 10 {
    s = "0" + s
  }
  s
}

///|
pub fn render(doc : Document) -> FixedArray[Byte] {
  let pages = layout(doc)
  let n_pages = pages.length()

  // Catalog 1, Pages 2, fonts 3 and 4; page i is 5+2i (dict) and 6+2i (content stream).
  let page_obj = fn(i : Int) { 5 + 2 * i }
  let content_obj = fn(i : Int) { 6 + 2 * i }

  let mut kids = ""
  for i = 0; i < n_pages; i = i + 1 {
    let sep = if i == 0 { "" } else { " " }
    kids = kids + sep + "\{page_obj(i)} 0 R"
  }

  let objects : Array[Array[Byte]] = []
  let c1 : Array[Byte] = []
  push_str(c1, "<< /Type /Catalog /Pages 2 0 R >>")
  objects.push(c1)

  let c2 : Array[Byte] = []
  push_str(c2, "<< /Type /Pages /Kids [ \{kids} ] /Count \{n_pages} /MediaBox [0 0 \{page_w} \{page_h}] >>")
  objects.push(c2)

  let c3 : Array[Byte] = []
  push_str(c3, "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>")
  objects.push(c3)

  let c4 : Array[Byte] = []
  push_str(c4, "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>")
  objects.push(c4)

  for _ in 0..<(2 * n_pages) {
    objects.push([])
  }

  for i = 0; i < n_pages; i = i + 1 {
    let cbytes = content(pages[i])
    let page_str = "<< /Type /Page /Parent 2 0 R /Resources << /Font << /F1 3 0 R /F2 4 0 R >> >> /Contents \{content_obj(i)} 0 R >>"
    let stream_header = "<< /Length \{cbytes.length()} >>\nstream\n"
    let stream_footer = "\nendstream"

    let page_arr : Array[Byte] = []
    push_str(page_arr, page_str)

    let stream_arr : Array[Byte] = []
    push_str(stream_arr, stream_header)
    push_bytes(stream_arr, cbytes)
    push_str(stream_arr, stream_footer)

    objects[page_obj(i) - 1] = page_arr
    objects[content_obj(i) - 1] = stream_arr
  }

  let out : Array[Byte] = []
  push_str(out, "%PDF-1.4\n")

  let offsets : Array[Int] = []
  for i = 0; i < objects.length(); i = i + 1 {
    offsets.push(out.length())
    push_str(out, "\{i + 1} 0 obj\n")
    push_bytes(out, objects[i])
    push_str(out, "\nendobj\n")
  }

  let xref_at = out.length()
  let size = objects.length() + 1
  push_str(out, "xref\n0 \{size}\n0000000000 65535 f \n")
  for off in offsets {
    push_str(out, "\{pad10(off)} 00000 n \n")
  }
  push_str(out, "trailer\n<< /Size \{size} /Root 1 0 R >>\nstartxref\n\{xref_at}\n%%EOF")

  FixedArray::from_array(out)
}
