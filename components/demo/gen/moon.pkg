import {
  "demo/shape/gen/interface/demo/shape/pager" @pager,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportPaginate:demo:shape/pager@0.1.0#paginate",
        "wasmExportPaginatePostReturn:cabi_post_demo:shape/pager@0.1.0#paginate"
      ],
    },
  },
)
