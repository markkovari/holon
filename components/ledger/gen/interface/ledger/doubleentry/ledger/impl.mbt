///|
priv struct AccSlot {
  account : String
  mut debits : Int64
  mut credits : Int64
}

///|
fn get_or_insert(accs : Array[AccSlot], account : String) -> AccSlot {
  for slot in accs {
    if slot.account == account {
      return slot
    }
  }
  let new_slot : AccSlot = { account, debits: 0L, credits: 0L }
  accs.push(new_slot)
  new_slot
}

///|
fn sort_accounts(accs : Array[AccSlot]) -> Unit {
  for i = 1; i < accs.length(); i = i + 1 {
    let key = accs[i]
    let mut j = i - 1
    while j >= 0 && accs[j].account > key.account {
      accs[j + 1] = accs[j]
      j = j - 1
    }
    accs[j + 1] = key
  }
}

///|
fn totals(e : Entry) -> Result[(Int64, Int64), LedgerError] {
  if e.lines.length() < 2 {
    return Err(TooFewLines)
  }
  let mut debits = 0L
  let mut credits = 0L
  for l in e.lines {
    if l.amount <= 0L {
      return Err(Nonpositive(l.account))
    }
    match l.side {
      DEBIT => debits = debits + l.amount
      CREDIT => credits = credits + l.amount
    }
  }
  Ok((debits, credits))
}

///|
pub fn validate(e : Entry) -> Result[Unit, LedgerError] {
  match totals(e) {
    Ok((debits, credits)) => {
      if debits != credits {
        Err(Unbalanced((debits, credits)))
      } else {
        Ok(())
      }
    }
    Err(err) => Err(err)
  }
}

///|
pub fn trial_balance(entries : Array[Entry]) -> Result[Trial, LedgerError] {
  let accs : Array[AccSlot] = []
  for e in entries {
    let (debits, credits) = match totals(e) {
      Ok(v) => v
      Err(err) => return Err(err)
    }
    if debits != credits {
      return Err(Unbalanced((debits, credits)))
    }
    for l in e.lines {
      let slot = get_or_insert(accs, l.account)
      match l.side {
        DEBIT => slot.debits = slot.debits + l.amount
        CREDIT => slot.credits = slot.credits + l.amount
      }
    }
  }
  sort_accounts(accs)
  let mut total_debits = 0L
  let mut total_credits = 0L
  let accounts : Array[AccountBalance] = []
  for slot in accs {
    total_debits = total_debits + slot.debits
    total_credits = total_credits + slot.credits
    accounts.push({
      account: slot.account,
      debits: slot.debits,
      credits: slot.credits,
      net: slot.debits - slot.credits,
    })
  }
  Ok({
    accounts,
    total_debits,
    total_credits,
    balanced: total_debits == total_credits,
  })
}
