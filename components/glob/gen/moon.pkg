import {
  "demo/glob/gen/interface/demo/glob/matcher" @matcher,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportMatches:demo:glob/matcher@0.1.0#matches"
      ],
    },
  },
)
