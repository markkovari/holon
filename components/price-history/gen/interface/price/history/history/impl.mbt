// Generated by `wit-bindgen` 0.63.0. DO NOT EDIT!

///|
fn str_lt(a : String, b : String) -> Bool {
  let len_a = a.length()
  let len_b = b.length()
  let min_len = if len_a < len_b { len_a } else { len_b }
  for i = 0; i < min_len; i = i + 1 {
    let ca = a[i].to_int()
    let cb = b[i].to_int()
    if ca < cb {
      return true
    }
    if ca > cb {
      return false
    }
  }
  len_a < len_b
}

///|
fn kind_eq(a : QuoteKind, b : QuoteKind) -> Bool {
  a.ordinal() == b.ordinal()
}

///|
fn check_currency(matching : Array[Quote]) -> Result[Unit, PriceError] {
  let mut expected : String? = None
  for q in matching {
    match expected {
      None => expected = Some(q.currency)
      Some(e) => {
        if e != q.currency {
          return Err(MixedCurrency((e, q.currency)))
        }
      }
    }
  }
  Ok(())
}

///|
pub fn at(quotes : Array[Quote], kind : QuoteKind, at : UInt64) -> Result[Observed, PriceError] {
  let matching : Array[Quote] = []
  for q in quotes {
    if kind_eq(q.kind, kind) {
      matching.push(q)
    }
  }
  match check_currency(matching) {
    Ok(_) => ()
    Err(e) => return Err(e)
  }
  let mut best : Quote? = None
  for q in matching {
    if q.at <= at {
      match best {
        None => best = Some(q)
        Some(b) => {
          if q.at > b.at {
            best = Some(q)
          } else if q.at == b.at && str_lt(q.source, b.source) {
            best = Some(q)
          }
        }
      }
    }
  }
  match best {
    None => Err(NotYetPriced)
    Some(q) => {
      let carried = q.at != at
      let age_seconds = at - q.at
      Ok({
        unit_minor: q.unit_minor,
        currency: q.currency,
        source: q.source,
        observed_at: q.at,
        age_seconds,
        carried,
      })
    }
  }
}

///|
pub fn series(
  quotes : Array[Quote],
  kind : QuoteKind,
  since : UInt64,
  until : UInt64,
  step : UInt64,
) -> Result[Array[Point], PriceError] {
  if step == 0UL {
    return Err(ZeroStep)
  }
  let times : Array[UInt64] = []
  let mut t = since
  while true {
    times.push(t)
    if t >= until {
      break
    }
    let next = t + step
    if next <= until && next > t {
      t = next
    } else {
      break
    }
  }
  if times.length() > 0 && times[times.length() - 1] != until {
    times.push(until)
  }
  let points : Array[Point] = []
  for time in times {
    match at(quotes, kind, time) {
      Ok(obs) => {
        points.push({ at: time, unit_minor: obs.unit_minor, carried: obs.carried })
      }
      Err(NotYetPriced) => ()
      Err(e) => return Err(e)
    }
  }
  Ok(points)
}
