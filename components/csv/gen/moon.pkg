import {
  "csv/codec/gen/interface/csv/codec/codec" @codec,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportFormat:csv:codec/codec@0.1.0#format",
        "wasmExportFormatPostReturn:cabi_post_csv:codec/codec@0.1.0#format",
        "wasmExportParse:csv:codec/codec@0.1.0#parse",
        "wasmExportParsePostReturn:cabi_post_csv:codec/codec@0.1.0#parse",
        "wasmExportParseRecords:csv:codec/codec@0.1.0#parse-records",
        "wasmExportParseRecordsPostReturn:cabi_post_csv:codec/codec@0.1.0#parse-records"
      ],
    },
  },
)
