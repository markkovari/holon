// inspect:report — site inspections, checklist items, and a real downloadable
// PDF report per inspection.
//
// Same shape as `timesheet-domain`: auth:identity for real accounts/login/
// roles, policy:guard for "an inspector sees only their own inspections, an
// admin sees every one", records:store for storage, audit:log for a
// compliance trail, rate-limiter for login/register brute-force protection.
// New here: pdf:codec, to turn a completed inspection into a real PDF a
// browser can download, and id:generate for the inspection's own id.
package inspect:report@0.1.0;

world inspection-domain {
    export wasi:http/incoming-handler@0.2.0;

    import auth:identity/accounts@0.1.0;
    import auth:identity/authorizer@0.1.0;
    import auth:identity/session@0.1.0;
    import auth:identity/rbac@0.1.0;
    import auth:identity/types@0.1.0;

    import policy:guard/guard@0.1.0;
    import records:store/store@0.1.0;
    import audit:log/recorder@0.1.0;
    import ratelimit:guard/limiter@0.1.0;
    import id:generate/generator@0.1.0;
    import pdf:codec/codec@0.1.0;

    import wasi:clocks/wall-clock@0.2.0;
    import wasi:http/outgoing-handler@0.2.0;
}
