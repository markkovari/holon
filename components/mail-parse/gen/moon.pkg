import {
  "mail/parse/gen/interface/mail/parse/parser" @parser,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportParse:mail:parse/parser@0.1.0#parse",
        "wasmExportParsePostReturn:cabi_post_mail:parse/parser@0.1.0#parse"
      ],
    },
  },
)
