// Generated by `wit-bindgen` 0.63.0. DO NOT EDIT!

///|
priv struct Lot {
  mut quantity : UInt
  unit_minor : Int64
}

///|
priv struct ItemLots {
  item_id : String
  mut lots : Array[Lot]
}

///|
fn get_or_create_item(items : Array[ItemLots], item_id : String) -> ItemLots {
  for it in items {
    if it.item_id == item_id {
      return it
    }
  }
  let new_it : ItemLots = { item_id, lots: [] }
  items.push(new_it)
  new_it
}

///|
fn sort_events(evs : Array[Event]) -> Unit {
  for i = 1; i < evs.length(); i = i + 1 {
    let key = evs[i]
    let mut j = i - 1
    while j >= 0 && evs[j].at > key.at {
      evs[j + 1] = evs[j]
      j = j - 1
    }
    evs[j + 1] = key
  }
}

///|
fn find_best_quote(quotes : Array[Quote], item_id : String, at : UInt64, currency : String) -> Quote? {
  let mut best : Quote? = None
  for q in quotes {
    if q.item_id == item_id && q.at <= at && q.currency == currency {
      match best {
        None => best = Some(q)
        Some(b) => {
          if q.at > b.at {
            best = Some(q)
          }
        }
      }
    }
  }
  best
}

///|
pub fn value_at(events : Array[Event], quotes : Array[Quote], at : UInt64) -> Result[Valuation, ValueError] {
  if events.length() == 0 {
    return Err(Empty)
  }
  let currency = events[0].currency
  for e in events {
    if e.quantity == 0U {
      return Err(ZeroQuantity((e.item_id, e.at)))
    }
    if e.currency != currency {
      return Err(MixedCurrency((currency, e.currency)))
    }
  }

  let sorted = events.copy()
  sort_events(sorted)

  let items : Array[ItemLots] = []
  let mut realised = 0L

  for e in sorted {
    if e.at > at {
      continue
    }
    match e.kind {
      ACQUIRED => {
        let it = get_or_create_item(items, e.item_id)
        it.lots.push({ quantity: e.quantity, unit_minor: e.unit_minor })
      }
      DISPOSED => {
        let it = get_or_create_item(items, e.item_id)
        let mut held = 0U
        for l in it.lots {
          held = held + l.quantity
        }
        if held < e.quantity {
          return Err(OversoldAt((e.item_id, e.at, held, e.quantity)))
        }
        let mut remaining = e.quantity
        let mut cost = 0L
        let new_lots : Array[Lot] = []
        for l in it.lots {
          if remaining == 0U {
            new_lots.push(l)
          } else if l.quantity <= remaining {
            cost = cost + l.quantity.to_int64() * l.unit_minor
            remaining = remaining - l.quantity
          } else {
            cost = cost + remaining.to_int64() * l.unit_minor
            l.quantity = l.quantity - remaining
            remaining = 0U
            new_lots.push(l)
          }
        }
        it.lots = new_lots
        realised = realised + e.quantity.to_int64() * e.unit_minor - cost
      }
    }
  }

  let mut cost_basis = 0L
  let mut market_value = 0L
  let mut unquoted = 0U

  for it in items {
    let mut held = 0U
    let mut lot_cost = 0L
    for l in it.lots {
      held = held + l.quantity
      lot_cost = lot_cost + l.quantity.to_int64() * l.unit_minor
    }
    if held == 0U {
      continue
    }
    cost_basis = cost_basis + lot_cost
    match find_best_quote(quotes, it.item_id, at, currency) {
      Some(q) => {
        market_value = market_value + held.to_int64() * q.unit_minor
      }
      None => {
        market_value = market_value + lot_cost
        unquoted = unquoted + held
      }
    }
  }

  Ok({
    cost_basis_minor: cost_basis,
    market_value_minor: market_value,
    unrealised_minor: market_value - cost_basis,
    realised_minor: realised,
    currency,
    unquoted,
  })
}

///|
pub fn series(
  events : Array[Event],
  quotes : Array[Quote],
  since : UInt64,
  until : UInt64,
  step : UInt64,
) -> Result[Array[Point], ValueError] {
  if step == 0UL {
    return Err(ZeroStep)
  }
  let points : Array[Point] = []
  let mut t = since
  while true {
    let v = match value_at(events, quotes, t) {
      Ok(val) => val
      Err(e) => return Err(e)
    }
    points.push({
      at: t,
      market_value_minor: v.market_value_minor,
      cost_basis_minor: v.cost_basis_minor,
      realised_minor: v.realised_minor,
      unquoted: v.unquoted,
    })
    if t >= until {
      break
    }
    let next = t + step
    if next > until || next < t {
      t = until
    } else {
      t = next
    }
  }
  Ok(points)
}
