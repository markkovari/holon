import {
  "shaper/limit/gen/interface/shaper/limit/limiter" @limiter,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportGcra:shaper:limit/limiter@0.1.0#gcra",
        "wasmExportTokenBucket:shaper:limit/limiter@0.1.0#token-bucket"
      ],
    },
  },
)
