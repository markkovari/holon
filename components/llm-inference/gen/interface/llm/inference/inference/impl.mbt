let model_name : String = "mock-1"
let embed_dims : Int = 8

fn est_tokens(chars : Int) -> UInt {
  (chars / 4).reinterpret_as_uint()
}

fn char_at(s : String, i : Int) -> Char {
  s[i].to_int().unsafe_to_char()
}

fn sub_str(s : String, start : Int, end : Int) -> String {
  let buf = StringBuilder()
  let len = s.length()
  let actual_end = if end > len { len } else { end }
  for i = start; i < actual_end; i = i + 1 {
    buf.write_char(char_at(s, i))
  }
  buf.to_string()
}

fn trim_str(s : String) -> String {
  let len = s.length()
  let mut start = 0
  while start < len && (char_at(s, start) == ' ' || char_at(s, start) == '\t' || char_at(s, start) == '\n' || char_at(s, start) == '\r') {
    start = start + 1
  }
  let mut end = len
  while end > start && (char_at(s, end - 1) == ' ' || char_at(s, end - 1) == '\t' || char_at(s, end - 1) == '\n' || char_at(s, end - 1) == '\r') {
    end = end - 1
  }
  sub_str(s, start, end)
}

fn find_str(s : String, needle : String, from : Int) -> Int? {
  let s_len = s.length()
  let n_len = needle.length()
  if n_len == 0 {
    return Some(from)
  }
  if from + n_len > s_len {
    return None
  }
  for i = from; i <= s_len - n_len; i = i + 1 {
    let mut matched = true
    for j = 0; j < n_len; j = j + 1 {
      if s[i + j] != needle[j] {
        matched = false
        break
      }
    }
    if matched {
      return Some(i)
    }
  }
  None
}

fn split_char(s : String, delimiter : Char) -> Array[String] {
  let res : Array[String] = []
  let mut current = StringBuilder()
  for c in s {
    if c == delimiter {
      res.push(current.to_string())
      current = StringBuilder()
    } else {
      current.write_char(c)
    }
  }
  res.push(current.to_string())
  res
}

fn last_user_content(messages : Array[Message]) -> String {
  let len = messages.length()
  for i = len - 1; i >= 0; i = i - 1 {
    if messages[i].role is USER {
      return messages[i].content
    }
  }
  if len > 0 {
    messages[len - 1].content
  } else {
    ""
  }
}

fn all_content(messages : Array[Message]) -> String {
  let buf = StringBuilder()
  for m in messages {
    buf.write_string(m.content)
  }
  buf.to_string()
}

fn single_line(s : String) -> String {
  let buf = StringBuilder()
  let mut in_ws = false
  for c in s {
    if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
      if !in_ws && buf.to_string().length() > 0 {
        buf.write_char(' ')
        in_ws = true
      }
    } else {
      buf.write_char(c)
      in_ws = false
    }
  }
  buf.to_string()
}

fn items_after(text : String, marker : String) -> Array[String] {
  match find_str(text, marker, 0) {
    None => []
    Some(idx) => {
      let after = sub_str(text, idx + marker.length(), text.length())
      let mut end = after.length()
      for i = 0; i < after.length(); i = i + 1 {
        let c = after[i].to_int()
        if c == '.'.to_int() || c == '\n'.to_int() {
          end = i
          break
        }
      }
      let sub = sub_str(after, 0, end)
      let parts = split_char(sub, ',')
      let res : Array[String] = []
      for p in parts {
        let trimmed = trim_str(p)
        if !trimmed.is_empty() {
          res.push(trimmed)
        }
      }
      res
    }
  }
}

fn json_escape(s : String) -> String {
  let buf = StringBuilder()
  for c in s {
    match c {
      '"' => buf.write_string("\\\"")
      '\\' => buf.write_string("\\\\")
      '\n' => buf.write_string("\\n")
      '\r' => buf.write_string("\\r")
      '\t' => buf.write_string("\\t")
      _ => buf.write_char(c)
    }
  }
  buf.to_string()
}

fn mock_reply(messages : Array[Message]) -> String {
  let combined = all_content(messages)
  let user = last_user_content(messages)

  if combined.contains("Classify") && combined.contains("labels:") {
    let labels = items_after(combined, "labels:")
    if labels.length() > 0 {
      return labels[0]
    }
  }

  if combined.contains("Extract") && combined.contains("fields:") {
    let fields = items_after(combined, "fields:")
    if fields.length() > 0 {
      let buf = StringBuilder()
      for i = 0; i < fields.length(); i = i + 1 {
        if i > 0 {
          buf.write_char(',')
        }
        let key = json_escape(fields[i])
        buf.write_string("\"\{key}\":\"mock-\{key}\"")
      }
      return "{\{buf.to_string()}}"
    }
  }

  if combined.contains("Summarize") || combined.contains("summary") {
    let line = single_line(user)
    let truncated = if line.length() > 80 { sub_str(line, 0, 80) } else { line }
    return "Summary: \{truncated}"
  }

  "mock: \{user}"
}

///|
pub fn chat(messages : Array[Message], _opts : Options) -> Result[Completion, InferError] {
  if messages.is_empty() {
    return Err(InvalidRequest("no messages"))
  }
  let text = mock_reply(messages)
  let prompt_chars = all_content(messages).length()
  let completion : Completion = {
    text,
    finish_reason: "stop",
    model: model_name,
    usage: {
      prompt_tokens: est_tokens(prompt_chars),
      completion_tokens: est_tokens(text.length()),
    },
  }
  Ok(completion)
}

///|
pub fn complete(prompt : String, system : String, opts : Options) -> Result[Completion, InferError] {
  let messages : Array[Message] = []
  if !system.is_empty() {
    messages.push({ role: SYSTEM, content: system })
  }
  messages.push({ role: USER, content: prompt })
  chat(messages, opts)
}

///|
pub fn embed(text : String, _opts : Options) -> Result[FixedArray[Float], InferError] {
  let sums : FixedArray[Int64] = FixedArray::make(embed_dims, 0L)
  let len = text.length()
  for i = 0; i < len; i = i + 1 {
    let b = text[i].to_int().to_int64() & 0xFFL
    sums[i % embed_dims] = sums[i % embed_dims] + b
  }
  let per_bucket = (len + embed_dims - 1) / embed_dims
  let denom_int = if (per_bucket.to_int64() * 255L) > 1L { per_bucket.to_int64() * 255L } else { 1L }
  let denom = Float::from_int64(denom_int)
  let vec : FixedArray[Float] = FixedArray::make(embed_dims, (0.0 : Float))
  for i = 0; i < embed_dims; i = i + 1 {
    vec[i] = Float::from_int64(sums[i]) / denom
  }
  Ok(vec)
}

///|
pub fn describe() -> (String, Bool) {
  (model_name, true)
}
