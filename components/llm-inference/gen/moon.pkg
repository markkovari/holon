import {
  "llm/inference/gen/interface/llm/inference/inference" @inference,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportChat:llm:inference/inference@0.1.0#chat",
        "wasmExportChatPostReturn:cabi_post_llm:inference/inference@0.1.0#chat",
        "wasmExportComplete:llm:inference/inference@0.1.0#complete",
        "wasmExportCompletePostReturn:cabi_post_llm:inference/inference@0.1.0#complete",
        "wasmExportDescribe:llm:inference/inference@0.1.0#describe",
        "wasmExportDescribePostReturn:cabi_post_llm:inference/inference@0.1.0#describe",
        "wasmExportEmbed:llm:inference/inference@0.1.0#embed",
        "wasmExportEmbedPostReturn:cabi_post_llm:inference/inference@0.1.0#embed"
      ],
    },
  },
)
