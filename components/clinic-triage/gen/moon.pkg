import {
  "clinic/triage/gen/interface/clinic/triage/evaluator" @evaluator,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportEvaluate:clinic:triage/evaluator@0.1.0#evaluate",
        "wasmExportEvaluatePostReturn:cabi_post_clinic:triage/evaluator@0.1.0#evaluate",
        "wasmExportVariantInfo:clinic:triage/evaluator@0.1.0#variant-info",
        "wasmExportVariantInfoPostReturn:cabi_post_clinic:triage/evaluator@0.1.0#variant-info"
      ],
    },
  },
)
