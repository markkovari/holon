// eshop:gateway — the eShopOnDapr Envoy gateway + Blazor host, as one
// WIT HTTP component.
//
// Serves the embedded storefront SPA and forwards the API surface through the
// proxy:route capability — the route table (prefixes -> sibling services,
// plus the /pump/* fan-out targets) is deploy-time wasi:config on the
// composed proxy, so the same wasm fronts localhost native hosts and
// *.eshop.svc.cluster.local on Kubernetes.
//
//   /api/identity/*  -> identity  (prefix stripped: accounts-app serves /register &c.)
//   /api/catalog/*   -> catalog   (verbatim)
//   /api/basket*     -> basket    (verbatim)
//   /api/orders*     -> ordering  (verbatim)
//   /internal/pump   -> fan-out to every consumer service's pump
//   anything else    -> the SPA
package eshop:gateway@0.1.0;

/// The storefront edge, composed from capability contracts.
world gateway-service {
    export wasi:http/incoming-handler@0.2.0;

    // route-table + forwarding (the Envoy stand-in).
    import proxy:route/router@0.1.0;
}
