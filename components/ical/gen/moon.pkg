import {
  "ical/codec/gen/interface/ical/codec/codec" @codec,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportFormatCalendar:ical:codec/codec@0.1.0#format-calendar",
        "wasmExportFormatCalendarPostReturn:cabi_post_ical:codec/codec@0.1.0#format-calendar",
        "wasmExportFormatEvent:ical:codec/codec@0.1.0#format-event",
        "wasmExportFormatEventPostReturn:cabi_post_ical:codec/codec@0.1.0#format-event"
      ],
    },
  },
)
