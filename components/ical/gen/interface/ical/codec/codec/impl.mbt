// Generated by `wit-bindgen` 0.63.0. DO NOT EDIT!

///|
fn civil_from_days(days : Int64) -> (Int64, UInt, UInt) {
  let z = days + 719468L
  let era = (if z >= 0L { z } else { z - 146096L }) / 146097L
  let doe = (z - era * 146097L).to_int()
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe.to_int64() + era * 400L
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = (doy - (153 * mp + 2) / 5 + 1).reinterpret_as_uint()
  let m = (if mp < 10 { mp + 3 } else { mp - 9 }).reinterpret_as_uint()
  let yr = if m <= 2U { y + 1L } else { y }
  (yr, m, d)
}

///|
fn pad4(n : Int64) -> String {
  let s = n.to_string()
  if s.length() == 1 {
    "000" + s
  } else if s.length() == 2 {
    "00" + s
  } else if s.length() == 3 {
    "0" + s
  } else {
    s
  }
}

///|
fn pad2(n : UInt) -> String {
  if n < 10U {
    "0" + n.to_string()
  } else {
    n.to_string()
  }
}

///|
fn ts(secs : UInt64) -> String {
  let days = secs.reinterpret_as_int64() / 86400L
  let rem = (secs % 86400UL).reinterpret_as_int64().to_int().reinterpret_as_uint()
  let (y, m, d) = civil_from_days(days)
  let h = rem / 3600U
  let min = (rem % 3600U) / 60U
  let s = rem % 60U
  pad4(y) + pad2(m) + pad2(d) + "T" + pad2(h) + pad2(min) + pad2(s) + "Z"
}

///|
fn esc(s : String) -> String {
  let out = StringBuilder()
  for c in s {
    match c {
      '\\' => out.write_string("\\\\")
      ';' => out.write_string("\\;")
      ',' => out.write_string("\\,")
      '\n' => out.write_string("\\n")
      '\r' => ()
      _ => out.write_char(c)
    }
  }
  out.to_string()
}

///|
fn char_utf8_len(c : Char) -> Int {
  let cp = c.to_int()
  if cp <= 0x7F {
    1
  } else if cp <= 0x7FF {
    2
  } else if cp <= 0xFFFF {
    3
  } else {
    4
  }
}

///|
fn fold(line : String) -> String {
  let mut total_octets = 0
  for c in line {
    total_octets = total_octets + char_utf8_len(c)
  }
  if total_octets <= 75 {
    return line
  }
  let out = StringBuilder()
  let mut cur_octets = 0
  let mut max_octets = 75
  for c in line {
    let clen = char_utf8_len(c)
    if cur_octets + clen > max_octets {
      out.write_string("\r\n ")
      cur_octets = 1
      max_octets = 75
    }
    out.write_char(c)
    cur_octets = cur_octets + clen
  }
  out.to_string()
}

///|
fn vevent(ev : Event, lines : Array[String]) -> Unit {
  lines.push("BEGIN:VEVENT")
  lines.push("UID:" + esc(ev.uid))
  lines.push("DTSTAMP:" + ts(ev.start))
  lines.push("DTSTART:" + ts(ev.start))
  let end_ts = if ev.end > ev.start { ev.end } else { ev.start }
  lines.push("DTEND:" + ts(end_ts))
  lines.push("SUMMARY:" + esc(ev.summary))
  if !ev.description.is_empty() {
    lines.push("DESCRIPTION:" + esc(ev.description))
  }
  if !ev.location.is_empty() {
    lines.push("LOCATION:" + esc(ev.location))
  }
  if !ev.organizer.is_empty() {
    lines.push("ORGANIZER:mailto:" + ev.organizer)
  }
  if !ev.rrule.is_empty() {
    lines.push("RRULE:" + ev.rrule)
  }
  if ev.alarm_minutes > 0U {
    lines.push("BEGIN:VALARM")
    lines.push("ACTION:DISPLAY")
    lines.push("DESCRIPTION:" + esc(ev.summary))
    lines.push("TRIGGER:-PT" + ev.alarm_minutes.to_string() + "M")
    lines.push("END:VALARM")
  }
  lines.push("END:VEVENT")
}

///|
fn calendar(events : Array[Event], prod_id : String, cal_name : String) -> String {
  let lines : Array[String] = [
    "BEGIN:VCALENDAR",
    "VERSION:2.0",
    "PRODID:-//" + (if prod_id.is_empty() { "comp//ical" } else { prod_id }) + "//EN",
    "CALSCALE:GREGORIAN",
    "METHOD:PUBLISH",
  ]
  if !cal_name.is_empty() {
    lines.push("X-WR-CALNAME:" + esc(cal_name))
  }
  for ev in events {
    vevent(ev, lines)
  }
  lines.push("END:VCALENDAR")
  let out = StringBuilder()
  for l in lines {
    out.write_string(fold(l))
    out.write_string("\r\n")
  }
  out.to_string()
}

///|
pub fn format_event(ev : Event, prod_id : String) -> String {
  calendar([ev], prod_id, "")
}

///|
pub fn format_calendar(events : Array[Event], prod_id : String, cal_name : String) -> String {
  calendar(events, prod_id, cal_name)
}
