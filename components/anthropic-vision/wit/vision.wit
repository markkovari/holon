// anthropic:vision — the Anthropic provider for `vision:describe`.
//
// The CONTRACT lives in `components/vision-describe`, and this file used to be a
// verbatim copy of it with one extra world appended. That made two files declare
// `vision:describe@0.1.0`, which is a collision rather than duplication: a package
// name is a GLOBAL identifier in the component model, so two files claiming it with
// different contents is one name meaning two things. `tools/check-wit-packages.py`
// says so, and nothing ran it.
//
// Now the contract is a DEPENDENCY, resolved from `../vision-describe/wit`, and this
// package declares only what is actually its own: the world describing how this
// provider is wired. The exported interface is unchanged — still
// `vision:describe/describer@0.1.0` — so every composition and every guest sees
// exactly what it saw before.
package anthropic:vision@0.1.0;

/// `anthropic-vision` satisfies `vision:describe` over Anthropic's Messages API.
///
/// The same shape `components/photo-critic` proves: egress to one authority, the key
/// revealed from the vault rather than read from config, and the model chosen by
/// deployment. A guest that imports `describer` sees none of it.
world anthropic-vision {
    export vision:describe/describer@0.1.0;
    import comp:secrets/reader@0.1.0;
    import wasi:config/store@0.2.0-rc.1;
    import wasi:http/outgoing-handler@0.2.0;
}
