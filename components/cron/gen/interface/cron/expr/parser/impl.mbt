// Generated by `wit-bindgen` 0.44.0. DO NOT EDIT!

///|
let month_names : Array[(String, UInt)] = [
  ("jan", 1U), ("feb", 2U), ("mar", 3U), ("apr", 4U), ("may", 5U), ("jun", 6U),
  ("jul", 7U), ("aug", 8U), ("sep", 9U), ("oct", 10U), ("nov", 11U), ("dec", 12U),
]

///|
let dow_names : Array[(String, UInt)] = [
  ("sun", 0U), ("mon", 1U), ("tue", 2U), ("wed", 3U), ("thu", 4U), ("fri", 5U), ("sat", 6U),
]

///|
priv struct Schedule {
  min : Array[Bool]
  hour : Array[Bool]
  dom : Array[Bool]
  month : Array[Bool]
  dow : Array[Bool]
  dom_star : Bool
  dow_star : Bool
}

///|
fn inv(m : String) -> CronError {
  InvalidExpression(m)
}

///|
fn expand_macro(expr : String) -> String? {
  match expr.trim().to_owned() {
    "@yearly" | "@annually" => Some("0 0 1 1 *")
    "@monthly" => Some("0 0 1 * *")
    "@weekly" => Some("0 0 * * 0")
    "@daily" | "@midnight" => Some("0 0 * * *")
    "@hourly" => Some("0 * * * *")
    _ => None
  }
}

///|
fn split_whitespace(s : String) -> Array[String] {
  let res : Array[String] = []
  let mut current = StringBuilder()
  let mut cur_len = 0
  for c in s {
    if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
      if cur_len > 0 {
        res.push(current.to_string())
        current = StringBuilder()
        cur_len = 0
      }
    } else {
      current.write_char(c)
      cur_len = cur_len + 1
    }
  }
  if cur_len > 0 {
    res.push(current.to_string())
  }
  res
}

///|
fn split_char(s : String, delimiter : Char) -> Array[String] {
  let res : Array[String] = []
  let mut current = StringBuilder()
  for ch in s {
    if ch == delimiter {
      res.push(current.to_string())
      current = StringBuilder()
    } else {
      current.write_char(ch)
    }
  }
  res.push(current.to_string())
  res
}

///|
fn split_once(s : String, delimiter : Char) -> (String, String)? {
  for i = 0; i < s.length(); i = i + 1 {
    if s[i].to_int() == delimiter.to_int() {
      return Some((s[0:i].to_owned(), s[i + 1:s.length()].to_owned()))
    }
  }
  None
}

///|
fn parse_uint(s : String) -> UInt? {
  let trimmed = s.trim().to_owned()
  if trimmed.is_empty() {
    return None
  }
  let mut acc = 0U
  for c in trimmed {
    if c >= '0' && c <= '9' {
      acc = acc * 10U + (c.to_int() - 48).reinterpret_as_uint()
    } else {
      return None
    }
  }
  Some(acc)
}

///|
fn resolve(tok : String, names_list : Array[(String, UInt)], lo : UInt, hi : UInt) -> Result[UInt, CronError] {
  let t = tok.trim().to_owned().to_lower()
  for pair in names_list {
    if pair.0 == t {
      return Ok(pair.1)
    }
  }
  match parse_uint(t) {
    Some(v) => {
      if v < lo || v > hi {
        return Err(inv("\{v} out of range \{lo}-\{hi}"))
      }
      Ok(v)
    }
    None => Err(inv("not a number or name: '\{tok}'"))
  }
}

///|
fn parse_field(
  spec : String,
  lo : UInt,
  hi : UInt,
  names_list : Array[(String, UInt)],
) -> Result[(Array[Bool], Bool), CronError] {
  let size = (hi - lo + 1U).reinterpret_as_int()
  let bits : Array[Bool] = Array::make(size, false)
  let star = spec.trim().to_owned() == "*"
  for part in split_char(spec, ',') {
    let part_trimmed = part.trim().to_owned()
    if part_trimmed.is_empty() {
      return Err(inv("empty part in field '\{spec}'"))
    }
    let (rng, step) = match split_once(part_trimmed, '/') {
      Some((r, s)) => {
        match parse_uint(s) {
          Some(step_val) => (r, step_val)
          None => return Err(inv("bad step '\{s}' in '\{part_trimmed}'"))
        }
      }
      None => (part_trimmed, 1U)
    }
    if step == 0U {
      return Err(inv("step cannot be 0 in '\{part_trimmed}'"))
    }
    let (start_val, end_val) = if rng == "*" {
      (lo, hi)
    } else {
      match split_once(rng, '-') {
        Some((a, b)) => {
          let a_val = match resolve(a, names_list, lo, hi) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          let b_val = match resolve(b, names_list, lo, hi) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          if a_val > b_val {
            return Err(inv("range start \{a_val} > end \{b_val} in '\{part_trimmed}'"))
          }
          (a_val, b_val)
        }
        None => {
          let single = match resolve(rng, names_list, lo, hi) {
            Ok(v) => v
            Err(e) => return Err(e)
          }
          (single, single)
        }
      }
    }
    let mut cur = start_val
    while !(cur > end_val) {
      let idx = (cur - lo).reinterpret_as_int()
      bits[idx] = true
      cur = cur + step
    }
  }
  let mut any_set = false
  for b in bits {
    if b {
      any_set = true
      break
    }
  }
  if !any_set {
    return Err(inv("field '\{spec}' matched nothing"))
  }
  Ok((bits, star))
}

///|
fn build(expr : String) -> Result[Schedule, CronError] {
  let expanded = match expand_macro(expr) {
    Some(e) => e
    None => expr
  }
  let fields = split_whitespace(expanded)
  if fields.length() != 5 {
    return Err(inv("cron expression must have 5 fields, got \{fields.length()}"))
  }
  let (min, _) = match parse_field(fields[0], 0U, 59U, []) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (hour, _) = match parse_field(fields[1], 0U, 23U, []) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (dom, dom_star) = match parse_field(fields[2], 1U, 31U, []) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (month, _) = match parse_field(fields[3], 1U, 12U, month_names) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let (dow_raw, dow_star) = match parse_field(fields[4], 0U, 7U, dow_names) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let dow = Array::make(7, false)
  for i = 0; i < 7; i = i + 1 {
    dow[i] = dow_raw[i]
  }
  if dow_raw[7] {
    dow[0] = true
  }
  Ok({
    min,
    hour,
    dom,
    month,
    dow,
    dom_star,
    dow_star,
  })
}

///|
pub fn civil_from_days(z : Int64) -> (Int64, UInt, UInt) {
  let z_adj = z + 719468L
  let era = (if z_adj >= 0L { z_adj } else { z_adj - 146096L }) / 146097L
  let doe = (z_adj - era * 146097L).to_int()
  let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  let y = yoe.to_int64() + era * 400L
  let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  let mp = (5 * doy + 2) / 153
  let d = (doy - (153 * mp + 2) / 5 + 1).reinterpret_as_uint()
  let m = (if mp < 10 { mp + 3 } else { mp - 9 }).reinterpret_as_uint()
  let yr = if m <= 2U { y + 1L } else { y }
  (yr, m, d)
}

///|
pub fn weekday(z : Int64) -> UInt {
  let rem = ((z + 4L) % 7L).to_int()
  let res = if rem < 0 { rem + 7 } else { rem }
  res.reinterpret_as_uint()
}

///|
fn day_matches(s : Schedule, dom : UInt, dow : UInt) -> Bool {
  let dom_match = s.dom[(dom - 1U).reinterpret_as_int()]
  let dow_match = s.dow[dow.reinterpret_as_int()]
  match (s.dom_star, s.dow_star) {
    (true, true) => true
    (true, false) => dow_match
    (false, true) => dom_match
    (false, false) => dom_match || dow_match
  }
}

///|
fn matches_at(s : Schedule, unix : UInt64) -> Bool {
  let day = unix.reinterpret_as_int64() / 86400L
  let (_, m, d) = civil_from_days(day)
  let wd = weekday(day)
  if !s.month[(m - 1U).reinterpret_as_int()] {
    return false
  }
  if !day_matches(s, d, wd) {
    return false
  }
  let tod = ((unix % 86400UL).reinterpret_as_int64()).to_int()
  let min = (tod / 60) % 60
  let hour = tod / 3600
  s.hour[hour] && s.min[min]
}

///|
fn field_str(bits : Array[Bool], lo : UInt) -> String {
  let mut all_set = true
  for b in bits {
    if !b {
      all_set = false
      break
    }
  }
  if all_set {
    return "*"
  }
  let buf = StringBuilder()
  let mut first = true
  for i = 0; i < bits.length(); i = i + 1 {
    if bits[i] {
      if !first {
        buf.write_char(',')
      }
      first = false
      let v = lo + i.reinterpret_as_uint()
      buf.write_string("\{v}")
    }
  }
  buf.to_string()
}

///|
fn normalize(s : Schedule) -> String {
  field_str(s.min, 0U) + " " +
  field_str(s.hour, 0U) + " " +
  field_str(s.dom, 1U) + " " +
  field_str(s.month, 1U) + " " +
  field_str(s.dow, 0U)
}

///|
pub fn parse(expr : String) -> Result[String, CronError] {
  match build(expr) {
    Ok(s) => Ok(normalize(s))
    Err(e) => Err(e)
  }
}

///|
pub fn matches(expr : String, unix : UInt64) -> Result[Bool, CronError] {
  match build(expr) {
    Ok(s) => Ok(matches_at(s, unix))
    Err(e) => Err(e)
  }
}

///|
pub fn next(expr : String, after : UInt64, count : UInt) -> Result[FixedArray[UInt64], CronError] {
  let s = match build(expr) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let cnt = count.reinterpret_as_int()
  if cnt == 0 {
    return Ok(FixedArray::make(0, 0UL))
  }
  let out : Array[UInt64] = []
  let mut t = (after / 60UL + 1UL) * 60UL
  for _day_idx = 0; _day_idx < 8 * 366; _day_idx = _day_idx + 1 {
    let day = t.reinterpret_as_int64() / 86400L
    let day_start = day.reinterpret_as_uint64() * 86400UL
    let (_, m, d) = civil_from_days(day)
    let wd = weekday(day)
    if s.month[(m - 1U).reinterpret_as_int()] && day_matches(s, d, wd) {
      let start_slot = (((t - day_start) / 60UL).reinterpret_as_int64()).to_int()
      for slot = start_slot; slot < 1440; slot = slot + 1 {
        if s.hour[slot / 60] && s.min[slot % 60] {
          out.push(day_start + slot.to_int64().reinterpret_as_uint64() * 60UL)
          if out.length() == cnt {
            let fixed = FixedArray::make(cnt, 0UL)
            for i = 0; i < cnt; i = i + 1 {
              fixed[i] = out[i]
            }
            return Ok(fixed)
          }
        }
      }
    }
    t = day_start + 86400UL
  }
  if out.length() == 0 {
    return Err(Unsatisfiable("'\{expr}' does not fire within the 8-year horizon"))
  }
  let fixed = FixedArray::make(out.length(), 0UL)
  for i = 0; i < out.length(); i = i + 1 {
    fixed[i] = out[i]
  }
  Ok(fixed)
}
