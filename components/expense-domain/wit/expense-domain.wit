// expense:reports — employee expense reports, submitted and approved.
//
// Same shape as `billing-domain`/`crm-domain`: auth:identity for real
// accounts/login/roles, policy:guard for "an employee sees only their own
// reports", records:store for storage, audit:log for a compliance trail
// (money moving is exactly the kind of record that needs one), rate-limiter
// for login/register brute-force protection.
package expense:reports@0.1.0;

world expense-domain {
    export wasi:http/incoming-handler@0.2.0;

    import auth:identity/accounts@0.1.0;
    import auth:identity/authorizer@0.1.0;
    import auth:identity/session@0.1.0;
    import auth:identity/rbac@0.1.0;
    import auth:identity/types@0.1.0;

    import policy:guard/guard@0.1.0;
    import records:store/store@0.1.0;
    import audit:log/recorder@0.1.0;
    import ratelimit:guard/limiter@0.1.0;

    import wasi:clocks/wall-clock@0.2.0;
    import wasi:http/outgoing-handler@0.2.0;
}
