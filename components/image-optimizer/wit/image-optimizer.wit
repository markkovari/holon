// media:image — shrink a picture by re-encoding it, as a contract.
//
// 0.3.0: bytes in, bytes out. 0.2.0 took a filesystem path and needed a native daemon to read it;
// the codec runs in the component now, so nothing native is left (ADR-0095).
package media:image@0.3.0;

interface optimizer {
    variant image-error {
        /// Not a picture this can decode (JPEG, PNG, GIF, WebP), or a damaged one.
        not-an-image(string),
        /// More pixels than this component decodes within its memory.
        too-large(string),
    }

    /// `img` no wider than the configured maximum (`image-max-width`, default 1600), re-encoded in
    /// its own format; a JPEG at `image-quality` (default 80).
    optimize: func(img: list<u8>) -> result<list<u8>, image-error>;
}

world component {
    export optimizer;
    import wasi:config/store@0.2.0-rc.1;
}
