// zip:archive — a ZIP archive writer.
//
// "Download all my data as a .zip" is on every app's roadmap, and the usual
// answer pulls in a zip crate (and often a compression backend). This is a tiny,
// dependency-free writer: a list of named byte blobs in, a valid `.zip` out —
// STORE method (no compression), so it's pure byte assembly plus a CRC-32 per
// entry, with correct local headers, a central directory, and the
// end-of-central-directory record. Any unzip tool reads it.
//
// Store-only keeps the WRITER small and exact; the archive isn't smaller than its
// inputs, which is fine for bundling already-small text/CSV/JSON.
//
// ## Reading, added later, and why deflate came with it
//
// This said "deflate is a separate, much larger job and out of scope". It was, until
// something needed to read a `.xlsx` — which is a ZIP of XML, written by every
// spreadsheet on earth with DEFLATE. A reader that only handles STORE would refuse
// every real file, so the inflate is here.
//
// It lives in this component rather than a second one because a zip capability that
// can only write is half a capability, and `sheet:import` wanting to read one is not
// a reason to have two.
//
// Pure compute: bytes in, bytes out. No state, no host imports.
package zip:archive@0.1.0;

/// Assemble files into a ZIP archive.
interface archiver {
    /// One archive member: a path/name and its raw bytes.
    record file {
        /// The entry name (use `/` for folders, e.g. `docs/readme.md`).
        name: string,
        data: list<u8>,
    }

    /// Why an archive could not be read.
    variant zip-error {
        /// No end-of-central-directory record. Not a ZIP, or truncated so badly
        /// there is nothing to find.
        not-a-zip,
        /// A structure runs past the end of the input. Carries the byte offset it
        /// reached for, which is what tells a truncated upload from a corrupt one.
        truncated(u32),
        /// A compression method this cannot undo. Carries the method id — 0 is
        /// STORE and 8 is DEFLATE; anything else (bzip2, lzma, zstd) is refused
        /// rather than guessed at.
        unsupported-method(u32),
        /// The entry decompressed, and its CRC-32 is not the one the archive
        /// recorded. Carries the entry name. Checked rather than trusted: this is
        /// the difference between reading a file and reading something that used
        /// to be a file.
        bad-checksum(string),
        /// The DEFLATE stream itself is malformed. Carries where it gave up.
        bad-deflate(string),
    }

    /// Build a complete ZIP archive (STORE method) from `files`. Entries appear
    /// in the given order.
    archive: func(files: list<file>) -> list<u8>;

    /// Read an archive back. STORE and DEFLATE; every entry's CRC-32 is verified.
    ///
    /// Directory entries are dropped rather than returned as empty files — an
    /// `.xlsx` has several and a caller wanting `xl/worksheets/sheet1.xml` does not
    /// want to page past `xl/`.
    extract: func(bytes: list<u8>) -> result<list<file>, zip-error>;
}

/// `zip` provides the archiver; pure compute, no host imports.
world zip {
    export archiver;
}
