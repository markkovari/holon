// comp:secretprobe — an instrument, not a feature.
//
// It answers the two questions ADR-0051's design rests on, and neither can be asked
// with a catalogue component because none of them import the reader:
//
//   1. Does a guest naming a KEY get the secret the manifest granted, and nothing
//      when it names one it was not granted?
//   2. Does `reveal` actually reach the platform and come back with the value?
//
// It publishes what it reads, on purpose. That is the point of an instrument and it
// is why this belongs in no catalogue: ADR-0051 says plainly that a component granted
// a secret can reveal it, and this is what that sentence looks like.
package comp:secretprobe@0.1.0;

world secret-probe {
    export wasi:http/handler@0.3.0-rc-2026-03-15;
    import comp:secrets/reader@0.1.0;
}
