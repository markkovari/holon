import {
  "money/amount/gen/interface/money/amount/arithmetic" @arithmetic,
}

warnings = "-44"

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm": {
      "export-memory-name": "memory",
      "heap-start-address": 16,
      "exports": [
        "mbt_ffi_cabi_realloc:cabi_realloc",
        "wasmExportAdd:money:amount/arithmetic@0.1.0#add",
        "wasmExportAddPostReturn:cabi_post_money:amount/arithmetic@0.1.0#add",
        "wasmExportAllocate:money:amount/arithmetic@0.1.0#allocate",
        "wasmExportAllocatePostReturn:cabi_post_money:amount/arithmetic@0.1.0#allocate",
        "wasmExportCompare:money:amount/arithmetic@0.1.0#compare",
        "wasmExportComparePostReturn:cabi_post_money:amount/arithmetic@0.1.0#compare",
        "wasmExportFormat:money:amount/arithmetic@0.1.0#format",
        "wasmExportFormatPostReturn:cabi_post_money:amount/arithmetic@0.1.0#format",
        "wasmExportParse:money:amount/arithmetic@0.1.0#parse",
        "wasmExportParsePostReturn:cabi_post_money:amount/arithmetic@0.1.0#parse",
        "wasmExportScale:money:amount/arithmetic@0.1.0#scale",
        "wasmExportScalePostReturn:cabi_post_money:amount/arithmetic@0.1.0#scale",
        "wasmExportSubtract:money:amount/arithmetic@0.1.0#subtract",
        "wasmExportSubtractPostReturn:cabi_post_money:amount/arithmetic@0.1.0#subtract"
      ],
    },
  },
)
