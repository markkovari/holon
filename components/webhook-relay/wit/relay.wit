// relay:app — a webhook relay (tiny Hookdeck) as a WIT HTTP component.
//
// The reliability-trio showcase: an inbound delivery is HMAC-verified and
// replay-deduped (webhook:ingest, itself composed with idempotency-guard),
// optionally reshaped with a stored RFC 6902 patch / RFC 7386 merge-patch
// (json:patch), then parked on a durable at-least-once queue (outbox:dispatch).
// An explicit drain claims pending events and delivers each one as a SIGNED
// webhook (webhook:sign, github scheme) via notify:dispatch, with retry/backoff
// and a dead-letter lane handled entirely by the outbox contract. Ingest is
// rate-limited per source and every accept/reject/delivery lands in audit:log.
//
// Routes:
//   POST   /api/sources              {name, secret, destination, dest-secret, transform?}
//   GET    /api/sources              GET /api/sources/{id}   DELETE /api/sources/{id}
//   POST   /hook/{source-id}         x-relay-signature, x-relay-delivery  -> 202
//   POST   /api/drain                deliver pending events (explicit pump)
//   GET    /api/dead                 dead-lettered events
//   POST   /api/dead/{id}/replay     re-queue a dead letter
//   GET    /api/audit                ?limit -> recent audit events
package relay:app@0.1.0;

/// The webhook-relay HTTP backend, composed from capability contracts.
world relay-app {
    export wasi:http/incoming-handler@0.2.0;

    // Inbound HMAC verify and replay dedup, as TWO capabilities rather than one.
    //
    // This was `webhook:ingest/verifier`, whose `ingest` does both in a single call:
    // it verifies the signature and marks the delivery-id seen, atomically. That
    // atomicity is the bug. Everything that can still fail happens after it — the
    // transform (422) and the enqueue (503) — so a refused delivery left its id
    // burnt, and the sender's retry came back `200 {"replay": true}`. A webhook
    // sender retries on non-2xx and stops on 2xx, so answering 200 to a delivery
    // that was dropped tells it the event landed. Nothing queued, nothing
    // dead-lettered, and silent loss on the one path idempotency exists to protect.
    //
    // A single call cannot express it, because dedup here needs a RESERVATION that
    // is committed on success and released on failure. `idempotency:guard` is
    // exactly that shape — `begin` / `complete` / `forget`, and its own contract
    // says `forget` is for "the operation failed and the client should be allowed to
    // retry from scratch". So the mark is ours to hold, and the signature check is a
    // separate, side-effect-free call to the signer this world already imported.
    import idempotency:guard/store@0.1.0;
    // optional payload reshape: array -> RFC 6902 patch, object -> merge-patch.
    import json:patch/patcher@0.1.0;
    // durable at-least-once delivery queue with retry/backoff + dead letters.
    import outbox:dispatch/queue@0.1.0;
    // github-scheme HMAC signatures on outbound deliveries — and, since the split
    // above, the constant-time VERIFY on inbound ones too. Same interface, both
    // directions, and `verify` has no side effect, which is the whole point.
    import webhook:sign/signer@0.1.0;
    // outbound webhook delivery (wasi:http/outgoing-handler under the hood).
    import notify:dispatch/dispatcher@0.1.0;
    // per-source ingest abuse guard (failure counter + lockout).
    import ratelimit:guard/limiter@0.1.0;
    // accept/reject/delivery trail.
    import audit:log/types@0.1.0;
    import audit:log/recorder@0.1.0;
    import audit:log/query@0.1.0;
    // source configs (destination, transform, outbound secret).
    import records:store/store@0.1.0;

    // Inbound secrets live at `relay:secret:{source}`. `webhook:ingest` used to read
    // that key itself, given a `secret-ref`; now this component reads it and hands
    // the VALUE to `signer::verify`, which is why the key's location stopped being
    // part of another component's contract.
    import wasi:keyvalue/store@0.2.0-draft;
}
