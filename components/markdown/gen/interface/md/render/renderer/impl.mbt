// Generated by `wit-bindgen` 0.63.0. DO NOT EDIT!

fn char_at(s : String, i : Int) -> Char {
  s[i].to_int().unsafe_to_char()
}

fn is_ws(c : Char) -> Bool {
  c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn sub_str(s : String, start : Int, end : Int) -> String {
  let buf = StringBuilder()
  let len = s.length()
  let actual_end = if end > len { len } else { end }
  for i = start; i < actual_end; i = i + 1 {
    buf.write_char(char_at(s, i))
  }
  buf.to_string()
}

fn trim_str(s : String) -> String {
  let len = s.length()
  let mut start = 0
  while start < len && is_ws(char_at(s, start)) {
    start = start + 1
  }
  let mut end = len
  while end > start && is_ws(char_at(s, end - 1)) {
    end = end - 1
  }
  sub_str(s, start, end)
}

fn trim_start_str(s : String) -> String {
  let len = s.length()
  let mut start = 0
  while start < len && is_ws(char_at(s, start)) {
    start = start + 1
  }
  sub_str(s, start, len)
}

fn str_starts_with(s : String, prefix : String) -> Bool {
  let p_len = prefix.length()
  if s.length() < p_len {
    return false
  }
  for i = 0; i < p_len; i = i + 1 {
    if s[i] != prefix[i] {
      return false
    }
  }
  true
}

fn str_strip_prefix(s : String, prefix : String) -> String? {
  if str_starts_with(s, prefix) {
    Some(sub_str(s, prefix.length(), s.length()))
  } else {
    None
  }
}

fn find_char(s : String, ch : Char, from : Int) -> Int? {
  let len = s.length()
  for i = from; i < len; i = i + 1 {
    if char_at(s, i) == ch {
      return Some(i)
    }
  }
  None
}

fn find_str(s : String, needle : String, from : Int) -> Int? {
  let s_len = s.length()
  let n_len = needle.length()
  if n_len == 0 {
    return Some(from)
  }
  if from + n_len > s_len {
    return None
  }
  for i = from; i <= s_len - n_len; i = i + 1 {
    let mut matched = true
    for j = 0; j < n_len; j = j + 1 {
      if s[i + j] != needle[j] {
        matched = false
        break
      }
    }
    if matched {
      return Some(i)
    }
  }
  None
}

fn to_lower_char(c : Char) -> Char {
  if c >= 'A' && c <= 'Z' {
    (c.to_int() + 32).unsafe_to_char()
  } else {
    c
  }
}

fn to_lower(s : String) -> String {
  let buf = StringBuilder()
  for c in s {
    buf.write_char(to_lower_char(c))
  }
  buf.to_string()
}

fn split_lines(s : String) -> Array[String] {
  if s.is_empty() {
    return []
  }
  let res : Array[String] = []
  let mut current = StringBuilder()
  let len = s.length()
  let mut i = 0
  while i < len {
    let c = char_at(s, i)
    if c == '\r' {
      if i + 1 < len && char_at(s, i + 1) == '\n' {
        i = i + 1
      }
      res.push(current.to_string())
      current = StringBuilder()
    } else if c == '\n' {
      res.push(current.to_string())
      current = StringBuilder()
    } else {
      current.write_char(c)
    }
    i = i + 1
  }
  let last = current.to_string()
  if !last.is_empty() || (len > 0 && char_at(s, len - 1) != '\n' && char_at(s, len - 1) != '\r') {
    res.push(last)
  }
  res
}

fn join_str(arr : Array[String], sep : String) -> String {
  let buf = StringBuilder()
  for i = 0; i < arr.length(); i = i + 1 {
    if i > 0 {
      buf.write_string(sep)
    }
    buf.write_string(arr[i])
  }
  buf.to_string()
}

fn replace_char(s : String, target : Char, repl : String) -> String {
  let buf = StringBuilder()
  for c in s {
    if c == target {
      buf.write_string(repl)
    } else {
      buf.write_char(c)
    }
  }
  buf.to_string()
}

fn escape_html(s : String) -> String {
  let buf = StringBuilder()
  for c in s {
    match c {
      '&' => buf.write_string("&amp;")
      '<' => buf.write_string("&lt;")
      '>' => buf.write_string("&gt;")
      '"' => buf.write_string("&quot;")
      '\'' => buf.write_string("&#x27;")
      _ => buf.write_char(c)
    }
  }
  buf.to_string()
}

fn is_control_char(c : Char) -> Bool {
  let code = c.to_int()
  (code >= 0 && code <= 0x1F) || (code >= 0x7F && code <= 0x9F)
}

fn sanitize_url(url : String) -> String? {
  let trimmed = trim_str(url)
  for c in trimmed {
    if is_control_char(c) {
      return None
    }
  }
  let lower = to_lower(trimmed)
  let ok = str_starts_with(lower, "http://") ||
    str_starts_with(lower, "https://") ||
    str_starts_with(lower, "mailto:") ||
    str_starts_with(trimmed, "/") ||
    str_starts_with(trimmed, "#")
  if ok {
    Some(trimmed)
  } else {
    None
  }
}

fn inline_code(s : String) -> String {
  let buf = StringBuilder()
  let len = s.length()
  let mut i = 0
  while i < len {
    if char_at(s, i) == '`' {
      match find_char(s, '`', i + 1) {
        Some(close_idx) => {
          let inner = sub_str(s, i + 1, close_idx)
          buf.write_string("<code>")
          buf.write_string(inner)
          buf.write_string("</code>")
          i = close_idx + 1
          continue
        }
        None => ()
      }
    }
    buf.write_char(char_at(s, i))
    i = i + 1
  }
  buf.to_string()
}

fn inline_links(s : String, opts : Options) -> String {
  let buf = StringBuilder()
  let mut rest = s
  while true {
    match find_char(rest, '[', 0) {
      None => {
        buf.write_string(rest)
        break
      }
      Some(open) => {
        buf.write_string(sub_str(rest, 0, open))
        let after = sub_str(rest, open + 1, rest.length())
        match find_char(after, ']', 0) {
          None => {
            buf.write_char('[')
            rest = after
            continue
          }
          Some(close) => {
            let text = sub_str(after, 0, close)
            let tail = sub_str(after, close + 1, after.length())
            if str_starts_with(tail, "(") {
              let stripped = sub_str(tail, 1, tail.length())
              match find_char(stripped, ')', 0) {
                Some(paren) => {
                  let url = sub_str(stripped, 0, paren)
                  let remainder = sub_str(stripped, paren + 1, stripped.length())
                  match sanitize_url(url) {
                    Some(safe) => {
                      buf.write_string("<a href=\"")
                      buf.write_string(escape_html(safe))
                      buf.write_char('"')
                      if opts.safe_links {
                        buf.write_string(" rel=\"nofollow noopener\" target=\"_blank\"")
                      }
                      buf.write_char('>')
                      buf.write_string(text)
                      buf.write_string("</a>")
                    }
                    None => buf.write_string(text)
                  }
                  rest = remainder
                  continue
                }
                None => ()
              }
            }
            buf.write_char('[')
            buf.write_string(text)
            buf.write_char(']')
            rest = tail
          }
        }
      }
    }
  }
  buf.to_string()
}

fn inline_emphasis(s : String, marker : String, tag : String) -> String {
  let buf = StringBuilder()
  let m_len = marker.length()
  let mut rest = s
  while true {
    match find_str(rest, marker, 0) {
      None => {
        buf.write_string(rest)
        break
      }
      Some(open) => {
        let after = sub_str(rest, open + m_len, rest.length())
        match find_str(after, marker, 0) {
          Some(close) => {
            if close > 0 {
              buf.write_string(sub_str(rest, 0, open))
              buf.write_char('<')
              buf.write_string(tag)
              buf.write_char('>')
              buf.write_string(sub_str(after, 0, close))
              buf.write_string("</")
              buf.write_string(tag)
              buf.write_char('>')
              rest = sub_str(after, close + m_len, after.length())
            } else {
              buf.write_string(sub_str(rest, 0, open + m_len))
              rest = after
            }
          }
          None => {
            buf.write_string(sub_str(rest, 0, open + m_len))
            rest = after
          }
        }
      }
    }
  }
  buf.to_string()
}

fn inline_md(escaped : String, opts : Options) -> String {
  let with_code = inline_code(escaped)
  let with_links = inline_links(with_code, opts)
  let with_strong1 = inline_emphasis(with_links, "**", "strong")
  let with_strong2 = inline_emphasis(with_strong1, "__", "strong")
  let with_em1 = inline_emphasis(with_strong2, "*", "em")
  inline_emphasis(with_em1, "_", "em")
}

fn is_hr(line : String) -> Bool {
  let t = trim_str(line)
  let len = t.length()
  if len < 3 {
    return false
  }
  let mut all_dash = true
  let mut all_star = true
  for c in t {
    if c != '-' { all_dash = false }
    if c != '*' { all_star = false }
  }
  all_dash || all_star
}

fn heading_level(line : String) -> (Int, String)? {
  let mut n = 0
  let len = line.length()
  while n < len && char_at(line, n) == '#' {
    n = n + 1
  }
  if n >= 1 && n <= 6 {
    let rest = sub_str(line, n, len)
    if str_starts_with(rest, " ") {
      return Some((n, sub_str(rest, 1, rest.length())))
    }
    if rest.is_empty() {
      return Some((n, ""))
    }
  }
  None
}

fn ordered_item(line : String) -> String? {
  let mut digits = 0
  let len = line.length()
  while digits < len && char_at(line, digits) >= '0' && char_at(line, digits) <= '9' {
    digits = digits + 1
  }
  if digits == 0 {
    return None
  }
  let rest = sub_str(line, digits, len)
  match str_strip_prefix(rest, ". ") {
    Some(item) => Some(item)
    None => str_strip_prefix(rest, ") ")
  }
}

fn unordered_item(line : String) -> String? {
  match str_strip_prefix(line, "- ") {
    Some(item) => Some(item)
    None => str_strip_prefix(line, "* ")
  }
}

fn render_para(lines : Array[String], opts : Options) -> String {
  let joined = join_str(lines, "\n")
  let escaped = escape_html(joined)
  let formatted = inline_md(escaped, opts)
  if opts.hard_breaks {
    replace_char(formatted, '\n', "<br>\n")
  } else {
    replace_char(formatted, '\n', " ")
  }
}

fn first_word(s : String) -> String {
  let trimmed = trim_str(s)
  let len = trimmed.length()
  let mut i = 0
  while i < len && !is_ws(char_at(trimmed, i)) {
    i = i + 1
  }
  sub_str(trimmed, 0, i)
}

fn render_html(markdown : String, opts : Options) -> String {
  let lines = split_lines(markdown)
  let out = StringBuilder()
  let mut i = 0
  let n = lines.length()

  while i < n {
    let line = lines[i]

    if trim_str(line).is_empty() {
      i = i + 1
      continue
    }

    match str_strip_prefix(trim_start_str(line), "```") {
      Some(info) => {
        let trimmed_info = trim_str(info)
        let body : Array[String] = []
        i = i + 1
        while i < n && !str_starts_with(trim_start_str(lines[i]), "```") {
          body.push(lines[i])
          i = i + 1
        }
        if i < n {
          i = i + 1
        }
        out.write_string("<pre><code")
        if !trimmed_info.is_empty() {
          let lang = first_word(trimmed_info)
          out.write_string(" class=\"language-")
          out.write_string(escape_html(lang))
          out.write_char('"')
        }
        out.write_char('>')
        out.write_string(escape_html(join_str(body, "\n")))
        if !body.is_empty() {
          out.write_char('\n')
        }
        out.write_string("</code></pre>\n")
        continue
      }
      None => ()
    }

    if is_hr(line) {
      out.write_string("<hr>\n")
      i = i + 1
      continue
    }

    match heading_level(line) {
      Some((level, content)) => {
        let inner = inline_md(escape_html(trim_str(content)), opts)
        out.write_string("<h\{level}>\{inner}</h\{level}>\n")
        i = i + 1
        continue
      }
      None => ()
    }

    if str_starts_with(line, ">") {
      let quoted : Array[String] = []
      while i < n && str_starts_with(lines[i], ">") {
        let stripped = match str_strip_prefix(lines[i], "> ") {
          Some(s) => s
          None => match str_strip_prefix(lines[i], ">") {
            Some(s) => s
            None => ""
          }
        }
        quoted.push(stripped)
        i = i + 1
      }
      let inner = render_para(quoted, opts)
      out.write_string("<blockquote><p>")
      out.write_string(inner)
      out.write_string("</p></blockquote>\n")
      continue
    }

    if unordered_item(line) is Some(_) {
      out.write_string("<ul>\n")
      while i < n {
        match unordered_item(lines[i]) {
          Some(item) => {
            let inner = inline_md(escape_html(trim_str(item)), opts)
            out.write_string("<li>\{inner}</li>\n")
            i = i + 1
          }
          None => break
        }
      }
      out.write_string("</ul>\n")
      continue
    }

    if ordered_item(line) is Some(_) {
      out.write_string("<ol>\n")
      while i < n {
        match ordered_item(lines[i]) {
          Some(item) => {
            let inner = inline_md(escape_html(trim_str(item)), opts)
            out.write_string("<li>\{inner}</li>\n")
            i = i + 1
          }
          None => break
        }
      }
      out.write_string("</ol>\n")
      continue
    }

    let para : Array[String] = []
    while i < n {
      let l = lines[i]
      if trim_str(l).is_empty() ||
        is_hr(l) ||
        heading_level(l) is Some(_) ||
        str_starts_with(l, ">") ||
        str_starts_with(trim_start_str(l), "```") ||
        unordered_item(l) is Some(_) ||
        ordered_item(l) is Some(_) {
        break
      }
      para.push(l)
      i = i + 1
    }
    if !para.is_empty() {
      out.write_string("<p>")
      out.write_string(render_para(para, opts))
      out.write_string("</p>\n")
    }
  }

  out.to_string()
}

fn strip_inline(s : String) -> String {
  let buf = StringBuilder()
  let len = s.length()
  let mut i = 0
  while i < len {
    let c = char_at(s, i)
    if c == '*' || c == '_' || c == '`' {
      i = i + 1
      continue
    }
    if c == '[' {
      match find_char(s, ']', i + 1) {
        Some(close_bracket) => {
          let text = sub_str(s, i + 1, close_bracket)
          buf.write_string(strip_inline(text))
          i = close_bracket + 1
          if i < len && char_at(s, i) == '(' {
            match find_char(s, ')', i + 1) {
              Some(close_paren) => {
                i = close_paren + 1
              }
              None => ()
            }
          }
          continue
        }
        None => ()
      }
    }
    buf.write_char(c)
    i = i + 1
  }
  buf.to_string()
}

fn render_text(markdown : String) -> String {
  let lines = split_lines(markdown)
  let out : Array[String] = []
  let mut i = 0
  let n = lines.length()
  while i < n {
    let line = lines[i]
    if trim_str(line).is_empty() {
      i = i + 1
      continue
    }
    if str_starts_with(trim_start_str(line), "```") {
      i = i + 1
      while i < n && !str_starts_with(trim_start_str(lines[i]), "```") {
        out.push(lines[i])
        i = i + 1
      }
      if i < n {
        i = i + 1
      }
      continue
    }
    if is_hr(line) {
      i = i + 1
      continue
    }
    match heading_level(line) {
      Some((_, content)) => {
        out.push(strip_inline(trim_str(content)))
        i = i + 1
        continue
      }
      None => ()
    }
    if str_starts_with(line, ">") {
      let stripped = match str_strip_prefix(line, "> ") {
        Some(s) => s
        None => match str_strip_prefix(line, ">") {
          Some(s) => s
          None => ""
        }
      }
      out.push(strip_inline(trim_str(stripped)))
      i = i + 1
      continue
    }
    match unordered_item(line) {
      Some(item) => {
        out.push(strip_inline(trim_str(item)))
        i = i + 1
        continue
      }
      None => ()
    }
    match ordered_item(line) {
      Some(item) => {
        out.push(strip_inline(trim_str(item)))
        i = i + 1
        continue
      }
      None => ()
    }
    out.push(strip_inline(trim_str(line)))
    i = i + 1
  }
  join_str(out, "\n")
}

///|
pub fn to_html(markdown : String) -> String {
  let opts : Options = { hard_breaks: false, safe_links: true }
  render_html(markdown, opts)
}

///|
pub fn to_html_with(markdown : String, opts : Options) -> String {
  render_html(markdown, opts)
}

///|
pub fn to_text(markdown : String) -> String {
  render_text(markdown)
}
