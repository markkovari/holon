// Generated by `wit-bindgen` 0.63.0. DO NOT EDIT!

fn str_lt(a : String, b : String) -> Bool {
  let len_a = a.length()
  let len_b = b.length()
  let min_len = if len_a < len_b { len_a } else { len_b }
  for i = 0; i < min_len; i = i + 1 {
    let ca = a[i].to_int()
    let cb = b[i].to_int()
    if ca < cb {
      return true
    }
    if ca > cb {
      return false
    }
  }
  len_a < len_b
}

fn sort_strings(arr : Array[String]) -> Unit {
  let n = arr.length()
  for i = 0; i < n; i = i + 1 {
    for j = i + 1; j < n; j = j + 1 {
      if str_lt(arr[j], arr[i]) {
        let tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
      }
    }
  }
}

///|
pub fn legality(deck : Array[Slot]) -> Array[Illegal] {
  let why : Array[Illegal] = []

  for slot in deck {
    if slot.quantity == 0U {
      why.push(ZeroQuantity(slot.card_id))
    }
  }

  let mut total : UInt = 0U
  for slot in deck {
    total = total + slot.quantity
  }
  if total != 60U {
    why.push(WrongSize(total))
  }

  let mut has_basic = false
  for slot in deck {
    if slot.kind is BASIC_POKEMON && slot.quantity > 0U {
      has_basic = true
      break
    }
  }
  if !has_basic {
    why.push(NoBasicPokemon)
  }

  let names : Array[String] = []
  let counts : Array[UInt] = []
  for slot in deck {
    if !(slot.kind is BASIC_ENERGY) {
      let mut found = false
      for i = 0; i < names.length(); i = i + 1 {
        if names[i] == slot.name {
          counts[i] = counts[i] + slot.quantity
          found = true
          break
        }
      }
      if !found {
        names.push(slot.name)
        counts.push(slot.quantity)
      }
    }
  }

  // Sort names lexicographically like Rust BTreeMap
  let sorted_names = names.copy()
  sort_strings(sorted_names)

  for name in sorted_names {
    for i = 0; i < names.length(); i = i + 1 {
      if names[i] == name {
        if counts[i] > 4U {
          why.push(TooManyOfAName((name, counts[i])))
        }
        break
      }
    }
  }

  why
}

///|
pub fn shortfall(
  deck : Array[Slot],
  owned : Array[Owned],
  prices : Array[Price],
  currency : String
) -> ShortfallReport {
  let card_ids : Array[String] = []
  let card_names : Array[String] = []
  let needed_qtys : Array[UInt] = []

  for slot in deck {
    let mut found = false
    for i = 0; i < card_ids.length(); i = i + 1 {
      if card_ids[i] == slot.card_id {
        needed_qtys[i] = needed_qtys[i] + slot.quantity
        found = true
        break
      }
    }
    if !found {
      card_ids.push(slot.card_id)
      card_names.push(slot.name)
      needed_qtys.push(slot.quantity)
    }
  }

  let sorted_card_ids = card_ids.copy()
  sort_strings(sorted_card_ids)

  let have_ids : Array[String] = []
  let have_qtys : Array[UInt] = []
  for o in owned {
    let mut found = false
    for i = 0; i < have_ids.length(); i = i + 1 {
      if have_ids[i] == o.card_id {
        have_qtys[i] = have_qtys[i] + o.quantity
        found = true
        break
      }
    }
    if !found {
      have_ids.push(o.card_id)
      have_qtys.push(o.quantity)
    }
  }

  let missing : Array[Missing] = []
  let mut cost_minor : Int64 = 0L
  let mut unpriced : UInt = 0U

  for card_id in sorted_card_ids {
    let mut name = ""
    let mut need : UInt = 0U
    for i = 0; i < card_ids.length(); i = i + 1 {
      if card_ids[i] == card_id {
        name = card_names[i]
        need = needed_qtys[i]
        break
      }
    }

    let mut owned_qty : UInt = 0U
    for i = 0; i < have_ids.length(); i = i + 1 {
      if have_ids[i] == card_id {
        owned_qty = have_qtys[i]
        break
      }
    }

    if need <= owned_qty {
      continue
    }

    let qty = need - owned_qty
    let mut price_opt : Price? = None
    for p in prices {
      if p.card_id == card_id && p.currency == currency {
        price_opt = Some(p)
        break
      }
    }

    match price_opt {
      Some(p) => {
        let line_cost = p.unit_minor * qty.reinterpret_as_int().to_int64()
        cost_minor = cost_minor + line_cost
        missing.push({
          card_id,
          name,
          quantity: qty,
          cost_minor: Some(line_cost),
        })
      }
      None => {
        unpriced = unpriced + 1U
        missing.push({
          card_id,
          name,
          quantity: qty,
          cost_minor: None,
        })
      }
    }
  }

  { missing, cost_minor, currency, unpriced }
}
