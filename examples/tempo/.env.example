# Full Redis connection URL. Hosted providers (Upstash, DO Managed Valkey) are
# TLS-only — use rediss:// (double s). Example (Upstash):
REDIS_URL=rediss://default:YOUR_PASSWORD@oriented-alpaca-182022.upstash.io:6379

# --- OR use the bundled local Valkey instead of a hosted one ---
#   docker compose --profile local-redis up -d --build
#   REDIS_URL=redis://redis:6379

# On a droplet, run a prebuilt image instead of building locally:
# TEMPO_IMAGE=ghcr.io/<you>/tempo-app:0.1.0
