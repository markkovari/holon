// ui:assets — embedded static-file serving as a capability.
//
// THE one definition. `console-assets`, `track-assets` and `static-assets` all
// point `[package.metadata.component.target]` at this directory, so the three
// components that implement this contract cannot drift from each other.
//
// They were three byte-identical copies before. Identical is the good case:
// nothing had gone wrong yet, and the next edit to one of them was the bug.

package ui:assets@0.1.0;

/// Exact-path lookup over the embedded bundle.
interface files {
    /// One embedded asset.
    record asset {
        content-type: string,
        body: list<u8>,
    }

    /// The asset at `path` (e.g. "/index.html", "/assets/app.js"), or none.
    /// Callers implement their own SPA fallback by retrying "/index.html".
    get: func(path: string) -> option<asset>;
}

world ui-assets {
    export files;
}
