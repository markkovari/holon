// holon:vcs — an agent-native code store: an operation log over a commutative
// patch graph, instead of snapshots and line diffs (ADR-0099).
//
// The unit of change is a SYMBOL, not a line. An edit names the symbol it touches
// and the patch it was computed from; two edits to different symbols commute and
// both land, whatever order they arrive in. Two edits to the SAME symbol from the
// same parent do not — and that is not an error either: it becomes a `conflict`, a
// first-class record with both sides kept, which a resolver agent reads and settles
// with `resolve-conflict`. Nothing here ever blocks on a lock or asks an agent to
// rebase.
//
// Every call carries hashes and records, never a path on somebody's disk:
// components have no filesystem (ADR-0023). `snapshot-export` returns a tree
// manifest (and a git tree id) that the host materialises.
//
// Hashes are lower-case hex SHA-256 of the bytes they name, so any node can verify
// what it was handed.
package holon:vcs@0.1.0;

interface types {
    /// Lower-case hex SHA-256 — of a blob's bytes, or of a patch's canonical form.
    type hash = string;
    /// A conflict is named by the hash of its two sides, so the same collision
    /// found twice is one conflict.
    type conflict-id = string;
    /// Position in a workspace's operation log. Strictly increasing per workspace.
    type op-id = u64;
    /// A mutable line of work: a goal's branch, a swarm's shared head.
    type workspace-id = string;

    /// Who made a change. `id` is the agent; the rest is provenance.
    record agent {
        id: string,
        goal: option<string>,
        model: option<string>,
    }

    /// What kind of thing a symbol is. Language-neutral on purpose: a Rust `fn`
    /// and a WIT `func` are both functions to the graph.
    enum symbol-kind {
        module,
        function,
        method,
        struct-item,
        enum-item,
        trait-item,
        impl-block,
        constant,
        static-item,
        type-alias,
        macro-item,
        wit-interface,
        wit-world,
        wit-type,
        /// A whole file, for content no parser splits into symbols.
        file,
    }

    /// A symbol's identity, stable across edits to its body. `path` is the file
    /// within the component; `name` is the item path inside it
    /// (`orders::compute_total`, `Order::validate`).
    record symbol-id {
        component: string,
        path: string,
        name: string,
        kind: symbol-kind,
    }

    /// Content, either small enough to send inline or already in the object store.
    variant content {
        inline(string),
        blob(hash),
    }

    /// Where a symbol sits in its file, relative to the file's other live
    /// symbols. A file is its live symbols sorted by an order key — a fraction,
    /// so there is always room between two — with ties broken by symbol key, so
    /// every node lays a file out identically. Two agents placing two symbols
    /// at the same spot at once both land (they are different symbols); they
    /// tie, and the tie is deterministic.
    variant placement {
        /// Before every other symbol of the file.
        first,
        /// After every other symbol of the file.
        last,
        /// Immediately after this symbol (same component and path, live).
        after(symbol-id),
        /// Immediately before this symbol (same component and path, live).
        before(symbol-id),
    }

    /// What an edit does to its symbol.
    variant transformation {
        /// The symbol must not exist at `parent` (which must be `none`).
        create(content),
        /// New content for an existing symbol.
        replace(content),
        /// Remove the symbol. Its name is free again.
        delete,
        /// Same content, new `name`; identity moves with it. Refused with
        /// `name-taken` if another live symbol has that name.
        rename(string),
        /// Same content, new place in its file. A patch like any other: two
        /// concurrent moves of one symbol conflict.
        move(placement),
    }

    /// One edit, as an agent submits it.
    record patch-request {
        workspace: workspace-id,
        symbol: symbol-id,
        /// The symbol's patch this edit was computed from — its tip when the agent
        /// read it. `none` only for `create`.
        parent: option<hash>,
        change: transformation,
        agent: agent,
        message: option<string>,
        /// Symbols the new content uses; becomes `depends-on` edges in the graph.
        /// Replaced wholesale by each `create`/`replace`; kept by `rename`.
        depends-on: list<symbol-id>,
        /// Symbols (usually WIT items) the new content implements; `implements`
        /// edges, with the same lifetime as `depends-on`.
        implements: list<symbol-id>,
        /// The WIT item this symbol implements or declares
        /// (`package:ns/interface.func`). `none` keeps the current binding.
        wit-binding: option<string>,
        /// The oplog position the agent's view of the component reflects: the
        /// `as-of` of the `symbol-view`s it read (or `oplog-head`). It decides
        /// `commuted`. `none`: unknown — `commuted` is then measured from the op
        /// that landed `parent`, which over-reports (it also lists edits the
        /// agent may have read after fetching `parent`).
        read-at: option<op-id>,
        /// Where a `create` goes in its file; `none` appends (after every symbol
        /// placed or created before it). Only `create` takes one — `invalid`
        /// otherwise; to re-place a symbol, `move` it. Part of what the patch
        /// hash covers AS REQUESTED, so a retried placed create is a
        /// `duplicate` even if the file changed in between.
        position: option<placement>,
    }

    enum patch-outcome {
        /// `parent` was the tip; the symbol moved forward.
        applied,
        /// `parent` was the symbol's tip, and at least one patch to ANOTHER symbol
        /// of the same component landed after `read-at` (the agent had not seen
        /// it) — the edit commuted past those (listed in `commuted-with`) and
        /// landed.
        commuted,
        /// The symbol's tip moved on since `parent` (another edit to the same
        /// symbol landed first); a conflict now holds both. The tip is unchanged.
        conflicted,
        /// The identical change is already there; nothing was written.
        duplicate,
    }

    record commit-result {
        patch: hash,
        op: op-id,
        outcome: patch-outcome,
        /// The symbol's tip afterwards; `none` once deleted.
        tip: option<hash>,
        /// Concurrent patches this one commuted past.
        commuted-with: list<hash>,
        /// Set exactly when `outcome` is `conflicted`.
        conflict: option<conflict-id>,
    }

    enum conflict-state {
        open,
        resolved,
        /// Superseded without a resolution — e.g. the symbol was deleted.
        abandoned,
    }

    record conflict-side {
        patch: hash,
        agent: agent,
        /// `none` when this side deleted the symbol.
        content: option<content>,
    }

    /// Two edits to one symbol from one parent. Both are kept verbatim. `left`
    /// is the edit that landed (the symbol's tip), `right` the one that arrived
    /// after it; the tip stays at `left`, and edits that would move it are
    /// refused with `unresolved-conflict`, until a resolution lands. In an N-way
    /// race each loser is its own conflict against the winner.
    record conflict {
        id: conflict-id,
        workspace: workspace-id,
        symbol: symbol-id,
        base: option<hash>,
        left: conflict-side,
        right: conflict-side,
        state: conflict-state,
        opened-at: op-id,
        /// The resolution patch, once `state` is `resolved`.
        resolved-by: option<hash>,
    }

    record resolution-request {
        workspace: workspace-id,
        conflict: conflict-id,
        /// `replace` with merged content, or `delete`; `create` and `rename` are
        /// `invalid`.
        resolution: transformation,
        agent: agent,
        message: option<string>,
    }

    /// One pointer a single operation moved, so it can be moved back.
    record pointer-move {
        /// e.g. `ws/<workspace>/sym/<symbol key>`
        pointer: string,
        before: option<hash>,
        after: option<hash>,
    }

    variant op-kind {
        apply(hash),
        resolve(conflict-id),
        /// Undoing an earlier operation is itself an operation.
        revert(op-id),
    }

    record op-entry {
        id: op-id,
        workspace: workspace-id,
        /// Unix milliseconds.
        at: u64,
        agent: agent,
        kind: op-kind,
        moves: list<pointer-move>,
    }

    variant symbol-query {
        symbol(symbol-id),
        /// Every live symbol of a component.
        component(string),
    }

    record symbol-view {
        id: symbol-id,
        tip: hash,
        content: content,
        author: agent,
        /// The WIT item this symbol implements or declares, when known
        /// (`package:ns/interface.func`).
        wit-binding: option<string>,
        depends-on: list<symbol-id>,
        dependents: list<symbol-id>,
        implements: list<symbol-id>,
        open-conflicts: list<conflict-id>,
        /// The settled oplog head read BEFORE this view: every op at or below it
        /// is reflected here. Pass it back as `patch-request.read-at`.
        as-of: op-id,
    }

    record tree-entry {
        /// Relative to the component root.
        path: string,
        blob: hash,
        executable: bool,
    }

    /// A component's living graph, flattened back into files.
    record snapshot {
        workspace: workspace-id,
        component: string,
        /// The oplog position this snapshot is exactly the state after.
        at: op-id,
        entries: list<tree-entry>,
        /// The same tree as a git tree object id (SHA-1, as `vgit:store` names
        /// it), for a forge or a checkout.
        git-tree: option<string>,
    }

    /// The pointer and the two values a compare-and-set disagreed on.
    record cas-failure {
        pointer: string,
        expected: option<hash>,
        actual: option<hash>,
    }

    variant vcs-error {
        /// The object store, the pointer store or the graph was unreachable or
        /// refused. Retrying may help.
        storage-error(string),
        /// A pointer moved between read and write. Nothing was changed; re-read
        /// and retry. Distinct from a conflict: this is a race on OUR write, not a
        /// disagreement between two agents' edits.
        concurrent-modification(cas-failure),
        /// The operation needs these conflicts settled first (e.g. exporting a
        /// component that still has open conflicts).
        unresolved-conflict(list<conflict-id>),
        symbol-not-found(symbol-id),
        /// A `create` or `rename` wanted a name another live symbol holds, or
        /// lost the race for it to one. Nothing was written. Not a conflict: the
        /// two are different symbols, not two versions of one — whereas two
        /// `create`s of the same symbol id ARE one symbol, and the second is a
        /// conflict (or a duplicate).
        name-taken(symbol-id),
        /// A patch, op or conflict id that does not exist.
        not-found(string),
        /// The request is malformed: `create` with a parent, `replace` without one,
        /// a hash that is not 64 hex characters.
        invalid(string),
    }

    // ---- consistency ------------------------------------------------------------
    //
    // Pointers, the oplog and the graph are three stores with no transaction.
    // Every op is logged as an intent BEFORE its pointer writes, and the pointer
    // value names the op that wrote it, so any reader can tell whether a
    // half-done op landed and finish or abort it (ADR-0099, step three).
    // `verify` reports what is out of line; `repair` settles it.

    /// A pointer, what it holds, and the op its value names.
    record pointer-state {
        pointer: string,
        value: option<hash>,
        op: option<op-id>,
    }

    /// An op still pending after the lease.
    record stale-op {
        op: op-id,
        age-ms: u64,
        /// Whether its pointer write happened (repair finishes it) or not
        /// (repair aborts it).
        landed: bool,
    }

    /// A record the graph should have and does not.
    record missing-record {
        /// The pointer, or conflict id, that names it.
        by: string,
        hash: hash,
    }

    variant inconsistency {
        /// A pointer whose value no committed op explains.
        unexplained-pointer(pointer-state),
        /// An op still pending past the lease.
        stale-pending(stale-op),
        /// A tip whose patch record the graph lacks.
        missing-patch(missing-record),
        /// A symbol (by key) whose graph index entry is missing or behind its
        /// pointer.
        stale-mirror(string),
        /// A conflict naming a patch the graph lacks.
        dangling-conflict(missing-record),
        /// An open conflict nothing committed opened, or whose `left` is no
        /// longer its symbol's tip.
        orphan-conflict(conflict-id),
        /// A name reservation (by pointer) held for a symbol no longer called
        /// that, or a live symbol whose name is not reserved for it.
        stale-name(string),
    }

    record consistency-report {
        workspace: workspace-id,
        /// Ops read: every id in the log, whatever its state.
        ops: u64,
        /// Ops pending inside the lease — in flight, not inconsistent.
        in-flight: list<op-id>,
        issues: list<inconsistency>,
    }

    record repair-report {
        workspace: workspace-id,
        /// Pending ops whose pointer write had happened: finished.
        rolled-forward: list<op-id>,
        /// Pending ops whose pointer write had not, and now cannot, happen.
        aborted: list<op-id>,
        /// Issues found before that are gone after.
        fixed: list<inconsistency>,
        /// Issues left — none, unless something outside the engine wrote a store.
        remaining: list<inconsistency>,
    }
}

interface code-store {
    use types.{
        commit-result, conflict, conflict-id, conflict-state, op-entry, op-id,
        patch-request, resolution-request, snapshot, symbol-query, symbol-view,
        vcs-error, workspace-id, agent, consistency-report, repair-report,
    };

    /// Record one edit. Never blocks on another agent: it lands, commutes, or
    /// becomes a conflict.
    apply-patch: func(req: patch-request) -> result<commit-result, vcs-error>;

    /// Settle an open conflict with a canonical resolution patch whose parents are
    /// both sides.
    resolve-conflict: func(req: resolution-request) -> result<commit-result, vcs-error>;

    /// Undo one earlier operation by appending its inverse. Refused with
    /// `concurrent-modification` if a pointer it moved has moved again since.
    revert-op: func(workspace: workspace-id, op: op-id, by: agent) -> result<op-entry, vcs-error>;

    /// The living tree of one symbol or a whole component, with its graph edges.
    query-symbol: func(workspace: workspace-id, query: symbol-query) -> result<list<symbol-view>, vcs-error>;

    /// Flatten a component's living graph into files. Refused with
    /// `unresolved-conflict` while any of its symbols has an open conflict.
    snapshot-export: func(workspace: workspace-id, component: string) -> result<snapshot, vcs-error>;

    /// Conflicts in a workspace, optionally only those in one state.
    list-conflicts: func(workspace: workspace-id, state: option<conflict-state>) -> result<list<conflict>, vcs-error>;

    /// The committed operations, oldest first, starting after `after`. Stops
    /// before the first op still in flight, so paging by the last id returned
    /// never skips one that commits later.
    oplog: func(workspace: workspace-id, after: option<op-id>, limit: u32) -> result<list<op-entry>, vcs-error>;

    /// The settled head: the highest op id at and below which every op is
    /// committed or aborted (0 for an empty log). A view read after it reflects
    /// all of them; it is what `patch-request.read-at` takes.
    oplog-head: func(workspace: workspace-id) -> result<op-id, vcs-error>;

    /// Check the workspace's pointers, oplog and graph against each other.
    /// Changes nothing.
    verify: func(workspace: workspace-id) -> result<consistency-report, vcs-error>;

    /// Settle every pending op past the lease (finish it if its pointer write
    /// happened, abort it if not), re-finish every committed op — which
    /// rebuilds any graph record lost, from the log and the blobs — and verify
    /// again.
    repair: func(workspace: workspace-id) -> result<repair-report, vcs-error>;
}

/// Files in and out: what an agent with a working copy of real source files
/// needs besides the symbol-level calls above. `ingest-*` split files into
/// symbols (Rust and WIT; anything else is one `file` symbol) and turn the
/// difference against a read point into patches; `materialize` writes a
/// snapshot to a directory the SERVING side was allowed to write (a component
/// has no filesystem, ADR-0023, so the path is the daemon's, and outside its
/// allow-list the call is refused as `invalid`); `read-blob` fetches content
/// too large to come back `inline`. ADR-0099, *The service*.
interface files {
    use types.{agent, commit-result, hash, op-id, snapshot, symbol-id, vcs-error, workspace-id};

    /// What one patch of an ingest did.
    enum edit-kind {
        create,
        replace,
        delete,
        rename,
        /// Same content, new place in the file.
        move,
    }

    /// One patch an ingest sent. A refusal of one symbol (`unresolved-conflict`,
    /// `name-taken`, ...) is recorded here and the ingest goes on with the others
    /// — they commute. Only a storage outage fails the whole call.
    record ingest-patch {
        symbol: symbol-id,
        edit: edit-kind,
        outcome: result<commit-result, vcs-error>,
    }

    record ingest-report {
        path: string,
        /// The read point the file was diffed against, and the `read-at` every
        /// patch carried.
        read-at: op-id,
        /// Symbols whose bytes and place did not change: no patch.
        unchanged: list<symbol-id>,
        patches: list<ingest-patch>,
    }

    /// A file of a component, by its component-relative `/` path.
    record source-file {
        path: string,
        content: list<u8>,
    }

    record materialized {
        /// The directory written, canonical.
        dir: string,
        snapshot: snapshot,
        files: u32,
        bytes: u64,
    }

    /// Ingest an edited copy of one file, diffed against the component as of
    /// `read-at` (`none`: `oplog-head` now).
    ingest-file: func(workspace: workspace-id, component: string, file: source-file, by: agent, read-at: option<op-id>) -> result<ingest-report, vcs-error>;

    /// Ingest a set of files against one read point. With `prune`, the set is
    /// the whole component: a file the store has and the set does not is
    /// deleted, symbol by symbol.
    ingest-tree: func(workspace: workspace-id, component: string, files: list<source-file>, by: agent, read-at: option<op-id>, prune: bool) -> result<list<ingest-report>, vcs-error>;

    /// `snapshot-export`, written out: every entry under `dest` (created if
    /// missing, refused if it exists and is not empty), executables marked.
    /// Refused with `unresolved-conflict` like the export itself.
    materialize: func(workspace: workspace-id, component: string, dest: string) -> result<materialized, vcs-error>;

    /// The bytes a blob hash names.
    read-blob: func(blob: hash) -> result<list<u8>, vcs-error>;
}

/// What a store provides — the native daemon's component face, or an in-process
/// implementation.
world code-store-provider {
    export code-store;
    export files;
}

/// What an agent's component imports to use one.
world code-store-client {
    import code-store;
    import files;
}
