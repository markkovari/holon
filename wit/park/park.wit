// holon:park — a durable record of an outstanding call, instead of a thread
// blocked on its answer (ADR-0100).
//
// An agent turn dispatches an outbound call — to a model, a tool, another
// agent's queue, a batch job that takes minutes — and then has nothing to do
// until the answer shows up. `park` writes that down BEFORE the call is
// dispatched; `wake` closes it when the answer lands, however it lands (a
// webhook, a poller, another daemon noticing something finished); `pending`
// and `take-ready` are how whatever resumes the turn finds out.
//
// A ticket is content-addressed, the same reasoning as a vcs patch hash
// (`wit/vcs/vcs.wit`): parking the identical call twice is a no-op that
// returns the same ticket rather than a second record, so a caller that
// crashed right after `park` and retried on restart cannot double-park.
//
// This contract does not dispatch the call itself and does not know what an
// agent does with the answer — the same boundary `holon:vcs/code-store` draws
// around a patch. What made the call is either the caller (the common case)
// or, for a call worth checking on its own, the daemon behind this contract,
// per `outbound-call.poll` — that half is not fully specified here yet.
//
// 0.2.0 (ADR-0106) adds what a restarted turn may do about a call that never
// answered. The caller says, when it parks, whether sending the call again is
// harmless (`replay`); a call given up on without an answer is `interrupted`,
// and `take-ready` says so instead of leaving the turn to guess. Breaking
// against 0.1.0: `outbound-call` gains a field and `take-ready` returns a
// `resolution` rather than a bare `call-result`.
//
// 0.3.0 (ADR-0109) lets a call fan out. A call parked with a `group` is resolved by its
// children, not by `wake`; its children are calls parked with `parent`. Breaking against
// 0.2.0: `resolution` gains `joined`, and `outbound-call` and `ticket-entry` gain fields.
//
// 0.4.0 (ADR-0110) adds `commit`: several effects applied together, or not at all. A function
// and new types, so compatible with 0.3.0 in what a 0.3.0 caller uses; the version moves with
// the shape.
package holon:park@0.4.0;

interface types {
    /// A conversation or task this ticket belongs to. Opaque to this contract;
    /// whoever drives the turn defines what a session is.
    type session-id = string;
    /// Lower-case hex SHA-256 of `(session, correlation)` — a ticket names
    /// itself, so re-parking the same call is detectable without a lookup.
    type ticket-id = string;

    /// Who parked a call, or who cancelled one. The same shape as
    /// `holon:vcs/types.agent`, duplicated rather than imported — cross-package
    /// WIT imports would tie this contract's versioning to vcs's for three
    /// fields (ADR-0095's reasoning for why components duplicate small
    /// helpers rather than share a library).
    record agent {
        id: string,
        goal: option<string>,
        model: option<string>,
    }

    /// How to find an answer on its own, for a call whose provider does not
    /// push a webhook — a batch job checked by its status endpoint. Left
    /// deliberately thin: the polling loop itself is the engine's to design,
    /// not this sketch's.
    record poll-spec {
        url: string,
        interval-secs: u32,
    }

    /// One outbound call, as the caller describes it before dispatching it.
    record outbound-call {
        /// What a webhook or poller presents to `wake` to find this ticket
        /// again — a provider's request id, a job id, whatever the far side
        /// hands back. Unique per call; `wake` refuses `not-found` without a
        /// match.
        correlation: string,
        /// Free text for the oplog and a human reading it — never parsed.
        description: string,
        /// Unix milliseconds. A ticket still `parked` past this is `expired`:
        /// read as "answer this or explain it", not "still fine". It is also
        /// the only thing that ever makes anything give up on the call: with
        /// none, a call waits forever.
        deadline: option<u64>,
        poll: option<poll-spec>,
        replay: replay-policy,
        /// The group this call is a child of, by its `correlation` in the same session
        /// (ADR-0109). The group must be parked first, belong to this session, still be
        /// waiting, and have room: `invalid` otherwise. A child is settled by its own answer
        /// and then consumed by its group; it is never announced or taken on its own.
        parent: option<string>,
        /// Makes this call a group: it is resolved by its children, not by `wake`, and
        /// `take-ready` hands over how they ended. A group cannot be a child: they do not nest.
        group: option<group-spec>,
    }

    /// How a group is resolved by its children (ADR-0109).
    enum join-policy {
        /// Wait for every child to settle, however each ends.
        all-settled,
        /// Resolve as soon as one child fails (an `ok: false` answer, an interruption, or a
        /// cancellation). The children still outstanding are cancelled first, so a group
        /// never resolves with work still running.
        fail-fast,
    }

    record group-spec {
        policy: join-policy,
        /// How many children the group will have, 1 to 1024. An `all-settled` group
        /// resolves only once that many have been parked and settled; more are refused.
        children: u32,
    }

    /// Why a group resolved.
    enum join-outcome {
        /// Every child answered, and every answer was `ok`.
        all-answered,
        /// Every child settled and at least one failed.
        some-failed,
        /// `fail-fast`: a child failed, and the ones still outstanding were cancelled.
        failed-fast,
        /// The group's own deadline passed first; the children still outstanding were
        /// cancelled, and `missing` counts the ones never parked.
        timed-out,
    }

    /// How one child of a group ended.
    variant child-result {
        answered(call-result),
        interrupted(interruption),
        cancelled,
    }

    record child-outcome {
        ticket: ticket-id,
        correlation: string,
        ended: child-result,
    }

    /// One thing a `commit` does (ADR-0110): what the call of the same name does, naming by
    /// `correlation` a call that already exists.
    variant effect {
        park(outbound-call),
        wake(wake-effect),
        interrupt(interrupt-effect),
        /// Give up on the call with this correlation, as `cancel`.
        cancel(string),
    }

    record wake-effect {
        correlation: string,
        answer: call-result,
    }

    record interrupt-effect {
        correlation: string,
        reason: string,
    }

    /// What a commit returns: its id, and what each `park` in it said, in the order listed.
    record commit-result {
        batch: string,
        parked: list<park-result>,
    }

    /// What a group is resolved with: every child, in the order it was parked, and how each
    /// ended.
    record join-result {
        outcome: join-outcome,
        children: list<child-outcome>,
        /// Children the group was declared with that were never parked.
        missing: u32,
    }

    /// What may be done about this call if whatever made it dies while it is
    /// outstanding (ADR-0106). Only the caller knows whether sending it twice
    /// repeats an effect, so only the caller can say.
    enum replay-policy {
        /// Sending it again is harmless: a read, or a write the far side
        /// deduplicates on `correlation`. Past its deadline it is re-dispatched,
        /// a bounded number of times, and then treated as `unsafe`.
        safe,
        /// Sending it again might repeat an effect. Nothing here ever does; past
        /// its deadline the turn is told it was `interrupted`.
        unsafe,
        /// A restarted turn has no use for the answer. Past its deadline the
        /// ticket is cancelled and nobody is told.
        abandon,
    }

    /// What came back.
    record call-result {
        ok: bool,
        body: list<u8>,
        detail: option<string>,
    }

    /// Why a call was given up on without an answer. Its fate is unknown: it
    /// may have taken effect, and nothing here can say. For the model, or the
    /// person reading what the model was told.
    record interruption {
        reason: string,
        /// Unix milliseconds.
        at: u64,
        by: agent,
    }

    /// What `take-ready` hands over.
    variant resolution {
        /// The far side answered. `ok: false` is an answer.
        answered(call-result),
        /// No answer will come. The call may or may not have happened: check
        /// on the far side before repeating it.
        interrupted(interruption),
        /// A group: how every child ended, and why it stopped waiting (ADR-0109).
        joined(join-result),
    }

    enum park-outcome {
        /// A new ticket, now outstanding.
        parked,
        /// The identical call was already parked for this session; the
        /// existing ticket, not a new one. The call may already have been
        /// dispatched — by this caller before it restarted — so whether to
        /// dispatch it again is what its `replay` says: `safe`, yes; `unsafe`,
        /// no, wait for the answer or the deadline.
        already-parked,
        /// A wake for this exact call landed before `park` returned — the
        /// answer beat the registration. Nothing lost: the ticket is `ready`
        /// immediately, so the caller can `take-ready` without waiting on
        /// `PARK_WAKE`. Also what a call already `interrupted` reports: there
        /// is nothing to dispatch, and `take-ready` says why.
        already-woken,
    }

    record park-result {
        ticket: ticket-id,
        outcome: park-outcome,
    }

    enum turn-status {
        parked,
        /// Woken; its result has not been taken yet.
        ready,
        /// `take-ready` has consumed its result. Terminal.
        resumed,
        /// Given up on via `cancel`. Terminal.
        cancelled,
        /// Past its `deadline` with no wake. Not terminal — a late wake still
        /// lands and is logged, just no longer surfaced by `pending`.
        expired,
        /// Given up on without an answer (ADR-0106). Taken exactly like
        /// `ready`; `take-ready` returns `interrupted` rather than `answered`.
        /// Not terminal until taken or cancelled. A late wake is accepted and
        /// dropped.
        interrupted,
    }

    record ticket-entry {
        ticket: ticket-id,
        session: session-id,
        status: turn-status,
        parked-at: u64,
        woken-at: option<u64>,
        resumed-at: option<u64>,
        /// What the caller named the call. A ticket id is a hash; this is how a
        /// restarted turn finds the call in its own journal.
        correlation: string,
        replay: replay-policy,
        /// The current one: a re-dispatch pushes it out.
        deadline: option<u64>,
        /// How many times a recovery pass has granted a re-dispatch.
        redispatches: u32,
        interrupted-at: option<u64>,
        /// The group this ticket is a child of, as a ticket id.
        parent: option<ticket-id>,
        /// Set on a group.
        group: option<group-spec>,
    }

    variant park-error {
        /// No ticket matches — a bad id, or a `wake` whose `correlation`
        /// nothing parked has.
        not-found(ticket-id),
        /// `take-ready` or `cancel` on a ticket already `resumed` or
        /// `cancelled`.
        already-closed(ticket-id),
        storage-error(string),
        invalid(string),
    }
}

interface lot {
    use types.{
        agent, call-result, commit-result, effect, outbound-call, park-error, park-result,
        resolution, session-id, ticket-entry, ticket-id, turn-status,
    };

    /// Register an outstanding call before dispatching it. Idempotent per
    /// `park-outcome`'s `already-parked` and `already-woken` cases.
    park: func(session: session-id, call: outbound-call, by: agent) -> result<park-result, park-error>;

    /// The answer arrived. Refused `not-found` if no parked ticket's
    /// `correlation` matches, and `invalid` for a group: it is resolved by its children.
    wake: func(correlation: string, answer: call-result) -> result<ticket-id, park-error>;

    /// Every ticket for a session still `parked`, `ready` or `interrupted` —
    /// what a resumer, or the turn itself on restart, reads to find outstanding
    /// work.
    pending: func(session: session-id) -> result<list<ticket-entry>, park-error>;

    /// Consume a `ready` or `interrupted` ticket's resolution exactly once.
    /// `not-found` if it is neither — poll `pending`, or better, wait on the
    /// `PARK_WAKE` stream, rather than spin on this.
    take-ready: func(ticket: ticket-id) -> result<resolution, park-error>;

    /// Give up on a `parked` ticket without an answer: `take-ready` will then
    /// say, as an `interrupted`, that the call's fate is unknown. For a turn
    /// that restarted and will not wait for a call it must not repeat. Returns
    /// the status the ticket is in now: `interrupted`, or `ready` if the answer
    /// landed first (and then it is the answer that gets taken). Repeating it is
    /// not an error, and the first `reason` stands. `already-closed` once the
    /// ticket is `resumed` or `cancelled`; `invalid` with an empty `reason`,
    /// which is what the turn is told.
    interrupt: func(ticket: ticket-id, reason: string, by: agent) -> result<turn-status, park-error>;

    /// Give up on a `parked`, `ready` or `interrupted` ticket. A late wake
    /// against a cancelled ticket is logged and dropped, not an error to anyone.
    cancel: func(ticket: ticket-id, by: agent) -> result<_, park-error>;

    /// Apply these effects together, or not at all (ADR-0110). Every effect is checked before
    /// anything is written, so a list with one bad effect registers none of them
    /// (`invalid`). Then the whole list is written as one record, an intent, and from there
    /// the effects will all be applied or all undone, by this call or, if it dies, by a
    /// recovery pass: parks first, in order, because those can still be refused and can be
    /// undone (what a commit made is cancelled); then `wake`, `interrupt` and `cancel` in order,
    /// which cannot be undone and are each idempotent.
    ///
    /// Idempotent: the identical list again is the same commit, found done (its parks report
    /// `already-parked`) or finished from where it stopped. `invalid` if an effect is refused
    /// after the intent was written, and then what the commit parked has been cancelled.
    ///
    /// Atomic in what lasts and not in what is seen on the way: while a commit is pending a
    /// reader may see some of its tickets and not others.
    commit: func(session: session-id, effects: list<effect>, by: agent) -> result<commit-result, park-error>;

    /// One session's history, oldest first, starting after the given
    /// millisecond timestamp (`none`: from the start).
    oplog: func(session: session-id, after: option<u64>, limit: u32) -> result<list<ticket-entry>, park-error>;
}

/// What a park daemon provides — the native daemon's component face, or an
/// in-process implementation.
world lot-provider {
    export lot;
}

/// What an agent's component imports to use one.
world lot-client {
    import lot;
}
